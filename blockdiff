<body>
<div id="app">
  <header><b>blockdiff</b><span id="summary"></span><a id="prlink" target="blockdiff-pr" hidden></a>
    <button id="themebtn" title="Theme: system, dark, or light (t)">System theme (t)</button>
    <button id="notesbtn" aria-pressed="true" title="Show or hide the review notes (r)" hidden>Notes (r)</button>
    <button id="foldbtn" aria-pressed="false" title="Hide identical lines, keep 3 context lines (h)">Hide identical lines (h)</button>
    <span class="help">Alt+↓ / Alt+↑ or F7 / Shift+F7: next / previous change &nbsp; Alt+Shift+↓ / Alt+Shift+↑: next / previous file &nbsp; h: hide / show identical lines &nbsp; t: theme<span id="rhelp" hidden> &nbsp; r: notes</span></span></header>
  <div id="files"></div>
  <div class="ptitle" id="ltitle"></div><div class="gtitle"></div><div class="ptitle" id="rhead"><span id="rtitle"></span><button id="openbtn" title="Open this file in VS Code at the first line in view" hidden>Open file</button></div><div class="otitle"></div>
  <div class="pane" id="left"><div class="content" id="lc"></div></div>
  <svg id="gutter"></svg>
  <div class="pane" id="right"><div class="content" id="rc"></div></div>
  <div id="ov"></div>
  <div id="notes"><div class="grip" title="Drag to resize"></div>
    <div class="lgrip" title="Drag to move the left edge. Drop it at the right pane to keep the notes under that pane. Double-click: full width."></div>
    <div class="bar"><span id="notestitle"></span><span id="notescount"></span>
      <button id="ovbtn" aria-pressed="false" title="Show the start of the report and the notes that match no change">Report overview</button></div>
    <div id="notesbody"></div></div>
</div>
<script id="data" type="application/json">__DATA__</script>
<script>
"use strict";
const D = JSON.parse(document.getElementById("data").textContent);
const LH = 20;   // Row height in pixels. Must match the .r height in the CSS.
const CTX = 3;   // Context lines kept around each change when identical lines are hidden.
const L = document.getElementById("left"), R = document.getElementById("right");
const G = document.getElementById("gutter"), OV = document.getElementById("ov");
const FOLDBTN = document.getElementById("foldbtn");
let cur = -1, drawPending = false;
let LY = null;                 // Layout of the current file (see layout()).
const expanded = new Set();    // Folds that the user opened, as "file:line" keys.
// Hide identical lines by default. localStorage remembers the last choice of the user.
let folding = true;
try {
  const saved = localStorage.getItem("blockdiff.fold");
  if (saved !== null) folding = saved === "1";
} catch (e) { /* storage unavailable */ }

const hue = id => (id * 137.508 + 25) % 360;
const esc = s => s.replace(/[&<>"]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]));
const pathOf = f => f.new || f.old;
const base = p => p.slice(p.lastIndexOf("/") + 1);

// Render one line. "marks" are change highlights [[start, end], ...]. "syntax" holds
// syntax ranges [[start, end, class], ...]. Both can overlap, so the line is cut at
// every range boundary and each piece gets its syntax class and, if needed, a mark.
function lineHtml(text, marks, syntax) {
  marks = marks || [];
  syntax = syntax || [];
  if (!marks.length && !syntax.length) return esc(text);
  const cuts = new Set([0, text.length]);
  for (const [s, e] of marks) { cuts.add(s); cuts.add(e); }
  for (const [s, e] of syntax) { cuts.add(s); cuts.add(e); }
  const xs = [...cuts].filter(x => x >= 0 && x <= text.length).sort((a, b) => a - b);
  let out = "";
  for (let k = 0; k + 1 < xs.length; k++) {
    const a = xs[k], b = xs[k + 1];
    let piece = esc(text.slice(a, b));
    const syn = syntax.find(r => r[0] <= a && b <= r[1]);
    if (syn) piece = `<span class="k${syn[2]}">${piece}</span>`;
    if (marks.some(r => r[0] <= a && b <= r[1])) piece = `<mark>${piece}</mark>`;
    out += piece;
  }
  return out;
}

function tagText(mid, side) {
  const [kind, sf, si, df, dj, na, nb, changed, ws] = D.moves[mid];
  const otherFile = side === "a" ? df : sf, otherLine = (side === "a" ? dj : si) + 1;
  const where = otherFile === cur ? "line " + otherLine : base(pathOf(D.files[otherFile])) + ":" + otherLine;
  if (kind === "reindent") return "indentation changed";
  const space = ws === 2 ? "whitespace" : "indentation";
  let what = "moved";
  if (kind === "similar") {
    what += ` with ${changed} changed line${changed === 1 ? "" : "s"}` + (ws ? ` and ${space} changes` : "");
  } else if (ws) {
    what += `, only ${space} changed`;
  }
  return side === "a" ? `⇢ ${what} to ${where}` : `⇠ ${what} from ${where}`;
}

// ---------------------------------------------------------------- layout
// The layout maps file lines to display rows. When folding is on, each run of
// identical lines longer than the context becomes one fold row on both sides.
// Result: rowsA / rowsB (a line index, or a fold object per row), ya / yb (the row
// of each line, plus one entry for the end), and dops (the opcodes in row units).
function layout(f) {
  const rowsA = [], rowsB = [], folds = {};
  const ya = new Int32Array(f.a.length + 1), yb = new Int32Array(f.b.length + 1);
  const dops = [];
  const push = (t, i1, i2, j1, j2) => {
    const ra = rowsA.length, rb = rowsB.length;
    for (let i = i1; i < i2; i++) { ya[i] = rowsA.length; rowsA.push(i); }
    for (let j = j1; j < j2; j++) { yb[j] = rowsB.length; rowsB.push(j); }
    dops.push([t, ra, rowsA.length, rb, rowsB.length]);
  };
  f.ops.forEach(([t, i1, i2, j1, j2], k) => {
    if (t !== "e" || !folding) return push(t, i1, i2, j1, j2);
    const h1 = k === 0 ? i1 : i1 + CTX;
    const h2 = k === f.ops.length - 1 ? i2 : i2 - CTX;
    const key = cur + ":" + i1;
    if (h2 - h1 < 2 || expanded.has(key)) return push(t, i1, i2, j1, j2);
    const g1 = j1 + (h1 - i1), g2 = j1 + (h2 - i1);
    push("e", i1, h1, j1, g1);
    const fo = {key, n: h2 - h1, ia: h1, ib: g1};
    folds[key] = fo;
    for (let i = h1; i < h2; i++) ya[i] = rowsA.length;
    for (let j = g1; j < g2; j++) yb[j] = rowsB.length;
    dops.push(["f", rowsA.length, rowsA.length + 1, rowsB.length, rowsB.length + 1]);
    rowsA.push(fo);
    rowsB.push(fo);
    push("e", h2, i2, g2, j2);
  });
  ya[f.a.length] = rowsA.length;
  yb[f.b.length] = rowsB.length;
  return {rowsA, rowsB, ya, yb, dops, folds};
}

// Fill colors of changed blocks, per row class. Each block grows 1px up and down in
// its own fill color (an outer shadow), so a block with no lines still shows a band.
const BORDER = {d: "var(--del)", a: "var(--add)", c: "var(--chg)"};

function buildSide(f, side) {
  const lines = f[side], cls = f["c" + side], spans = f["s" + side], syntax = f["h" + side] || {};
  const rowsIn = side === "a" ? LY.rowsA : LY.rowsB;
  const mv = new Int32Array(lines.length).fill(-1), first = new Set();
  for (const [s, n, mid] of f["m" + side]) { first.add(s); for (let k = 0; k < n; k++) mv[s + k] = mid; }

  // A block is a run of rows with the same move, or else the same change class.
  // Each block extends 1px above and below in its own fill color.
  const key = r => {
    const e = rowsIn[r];
    if (e === undefined || typeof e !== "number") return "";
    if (mv[e] >= 0) return "m" + mv[e];
    return cls[e] === "e" ? "" : cls[e];
  };
  const color = r => {
    const e = rowsIn[r];
    return mv[e] >= 0 ? `hsl(${hue(mv[e])} var(--mv-s) var(--mv-l))` : BORDER[cls[e]];
  };
  // A block with zero height on this side: a 2px band where it belongs, 1px on each side.
  const gapTop = new Map(), gapBottom = new Map();
  for (const [t, a1, a2, b1, b2] of LY.dops) {
    const here = side === "a" ? [a1, a2] : [b1, b2], there = side === "a" ? [b1, b2] : [a1, a2];
    if (here[0] !== here[1] || there[0] === there[1] || (t !== "d" && t !== "a")) continue;
    const c = BORDER[t];
    if (here[0] < rowsIn.length) gapTop.set(here[0], c); else if (rowsIn.length) gapBottom.set(rowsIn.length - 1, c);
  }

  const rows = [];
  rowsIn.forEach((e, r) => {
    const shadows = [];
    const k = key(r);
    if (k && key(r - 1) !== k) shadows.push(`0 -1px 0 ${color(r)}`);
    if (k && key(r + 1) !== k) shadows.push(`0 1px 0 ${color(r)}`);
    if (gapTop.has(r)) shadows.push(`0 -1px 0 ${gapTop.get(r)}`, `inset 0 1px 0 ${gapTop.get(r)}`);
    if (gapBottom.has(r)) shadows.push(`0 1px 0 ${gapBottom.get(r)}`, `inset 0 -1px 0 ${gapBottom.get(r)}`);
    const shadow = shadows.length ? `box-shadow:${shadows.join(",")};` : "";
    rows.push(rowHtml(e, side, lines, cls, spans, syntax, mv, first, shadow));
  });
  return rows.join("");
}

function rowHtml(e, side, lines, cls, spans, syntax, mv, first, shadow) {
  {
    if (typeof e !== "number") {
      const st = shadow ? ` style="${shadow}"` : "";
      return `<div class="r fold" data-fold="${e.key}"${st} title="Click to show these lines"><span class="n">\u22ef</span><span class="t">\u22ef ${e.n} identical lines</span></div>`;
    }
    const i = e, m = mv[i];
    const style = (m >= 0 ? `--h:${hue(m)};` : "") + shadow;
    const attr = (m >= 0 ? ` data-m="${m}"` : "") + (style ? ` style="${style}"` : "");
    const tag = m >= 0 && first.has(i) ? `<span class="tag">${esc(tagText(m, side))}</span>` : "";
    return `<div class="r ${cls[i]}" data-i="${i}"${attr}><span class="n">${i + 1}</span><span class="t">${lineHtml(lines[i], spans[i], syntax[i])}${tag}</span></div>`;
  }
}

// Rebuild the panes of the current file. The caller sets the scroll position.
function render() {
  const f = D.files[cur];
  align = null;
  LY = layout(f);
  const lc = document.getElementById("lc"), rc = document.getElementById("rc");
  if (f.binary) {
    lc.innerHTML = rc.innerHTML = '<div class="binary">Binary file</div>';
  } else {
    lc.innerHTML = buildSide(f, "a");
    rc.innerHTML = buildSide(f, "b");
  }
  buildVirtual();
  buildOverview(f);
  sel = -1;
  updateNotes();
}

function showFile(i, scrollToFirst = true) {
  cur = i;
  const f = D.files[i];
  document.querySelectorAll(".fi").forEach((el, k) => el.classList.toggle("cur", k === i));
  document.querySelector(".fi.cur")?.scrollIntoView({block: "nearest"});
  document.getElementById("ltitle").textContent = f.old || "(added)";
  document.getElementById("rtitle").textContent = f.new || "(deleted)";
  document.getElementById("openbtn").hidden = !f.disk;
  render();
  let v = 0;
  if (scrollToFirst) {
    const k = LY.dops.findIndex(o => o[0] !== "e" && o[0] !== "f");
    if (k >= 0) v = LY.dv[k] - CONTEXT_ABOVE;
  }
  scrollToV(v, false);
}

// ---------------------------------------------------------------- minimap
// The left half shows the old file, the right half the new file.
// Both halves use the shared virtual axis, like the thumb. Thus a row in the minimap
// is at the same height as the thumb when the row shows in its pane.
function buildOverview(f) {
  const n = Math.max(VTOTAL, 1), side = s => (s === "la" ? "a" : "b");
  const mk = (cls, s, r1, r2, extra = "") => {
    const v1 = vOfRow(r1, side(s)), v2 = vOfRowEnd(r2, side(s));
    return `<div class="mk ${s} ${cls}" style="top:${(v1 / n) * 100}%;height:${(Math.max(v2 - v1, 0) / n) * 100}%${extra}"></div>`;
  };
  let h = "";
  for (const [t, a1, a2, b1, b2] of LY.dops) {
    if ((t === "d" || t === "c") && a2 > a1) h += mk(t, "la", a1, a2);
    if ((t === "a" || t === "c") && b2 > b1) h += mk(t, "rb", b1, b2);
  }
  for (const [s, n, mid] of f.ma) h += mk("mv", "la", LY.ya[s], LY.ya[s + n], `;--h:${hue(mid)}`);
  for (const [s, n, mid] of f.mb) h += mk("mv", "rb", LY.yb[s], LY.yb[s + n], `;--h:${hue(mid)}`);
  OV.innerHTML = h + '<div class="view" id="ovview"></div>' +
    '<div class="pv l" id="ovl"></div><div class="pv r" id="ovr"></div>' +
    '<button class="relink" id="relink" title="Link the panes again (Esc)">' +
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
    'stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>' +
    '<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></button>';
}

function updateThumb() {
  const v = document.getElementById("ovview");
  if (!v || !LY) return;
  const aligned = isAligned();
  OV.classList.toggle("aligned", aligned);
  if (aligned) OV.style.setProperty("--pos", (VTOTAL > 0 ? (vNow / VTOTAL) * 100 : 0) + "%");
  const [l1, l2] = paneFrac(L), [r1, r2] = paneFrac(R);
  const put = (el, a, b) => { el.style.top = a * 100 + "%"; el.style.height = (b - a) * 100 + "%"; };
  put(document.getElementById("ovl"), l1, l2);
  put(document.getElementById("ovr"), r1, r2);
  const [top, height] = thumbFrac();
  put(v, top, top + height);
}

// The rows that a pane shows, as fractions of the minimap height on the virtual axis.
function paneFrac(pane) {
  const side = pane === L ? "a" : "b", n = (side === "a" ? LY.rowsA : LY.rowsB).length;
  if (!n || VTOTAL <= 0) return [0, 0];
  const r1 = Math.min(Math.max(pane.scrollTop / LH, 0), n);
  const r2 = Math.min((pane.scrollTop + pane.clientHeight) / LH, n);
  return [vOfRow(r1, side) / VTOTAL, vOfRowEnd(r2, side) / VTOTAL];
}


// The thumb as fractions of the minimap height, on the shared virtual axis.
// At position v, the anchor row is at anchorFrac(v) of the pane height. So the
// pane shows the virtual range [v - f * S, v + (1 - f) * S] for S rows on screen.
function thumbFrac() {
  const S = L.clientHeight / LH;
  if (VTOTAL <= S) return [0, 1];
  const v = clampV(vNow);
  return [(v - anchorFrac(v) * S) / VTOTAL, S / VTOTAL];
}

// The inverse of thumbFrac(): the virtual position for a thumb top.
function vForThumbTop(t) {
  const S = L.clientHeight / LH;
  if (VTOTAL <= S) return 0;
  return clampV((t * VTOTAL * VTOTAL) / (VTOTAL - S));
}

// Click on the minimap to jump there. Drag the thumb (or anywhere) to scroll.
let drag = null;
OV.addEventListener("pointerdown", e => {
  if (!LY) return;
  if (e.target.closest(".relink")) { relink(); e.preventDefault(); return; }
  relink();  // Fade an alignment out instead of removing it at once.
  // Compute the thumb from the scroll position. The DOM thumb can lag one frame.
  const r = OV.getBoundingClientRect(), [tf, hf] = thumbFrac();
  const vTop = r.top + tf * r.height, vH = hf * r.height;
  const onThumb = e.clientY >= vTop && e.clientY <= vTop + Math.max(vH, 6);
  drag = {grab: onThumb ? e.clientY - vTop : vH / 2, top: r.top, height: r.height};
  try { OV.setPointerCapture(e.pointerId); } catch (err) { /* synthetic event */ }
  OV.classList.add("drag");
  if (!onThumb) dragTo(e.clientY, false);  // A click on the track: a smooth jump.
  e.preventDefault();
});
OV.addEventListener("pointermove", e => { if (drag) dragTo(e.clientY, true); });
const endDrag = () => { drag = null; OV.classList.remove("drag"); };
OV.addEventListener("pointerup", endDrag);
OV.addEventListener("pointercancel", endDrag);

// The minimap is direct manipulation, so it moves without animation.
// "follow" eases after the pointer (dragging). Otherwise the move is a smooth jump.
function dragTo(y, follow) {
  const frac = (y - drag.grab - drag.top) / drag.height;
  scrollToV(vForThumbTop(frac), true, follow);
}

// ---------------------------------------------------------------- scroll model
// Both panes follow one shared position "v", in virtual rows. Each block of the
// layout counts as long as its longer side. Thus v moves at a steady speed through
// a block, and the shorter side moves slower or stands still. No pane races.
// The anchor point moves from the top of the panes (v = 0) to the bottom (v = end),
// so both panes reach their start and their end together.
const WHEEL_SPEED = 0.5;   // Fraction of the browser wheel distance (0.5 = twice as slow).
const EASE_MS = 150;       // Time constant of the scroll easing, in milliseconds.
const CONTEXT_ABOVE = 2;   // Rows to show above a change after a jump.
const FOLLOW_MAX_SCREENS = 0.35;  // Speed limit of follow mode, in screens per 16 ms frame.
let VS = [], VTOTAL = 0;   // Virtual segments [v0, length, a1, a2, b1, b2] and total length.
let vNow = 0, vTarget = 0, animating = false, lastT = 0;
const expected = new Map(); // Scroll positions that the page itself set, per pane.

// Build the virtual segments. Also store the virtual start of each opcode in LY.dv.
function buildVirtual() {
  VS = [];
  LY.dv = [];
  let v = 0;
  for (const [t, a1, a2, b1, b2] of LY.dops) {
    LY.dv.push(v);
    const len = Math.max(a2 - a1, b2 - b1);
    if (len > 0) { VS.push([v, len, a1, a2, b1, b2]); v += len; }
  }
  VTOTAL = v;
}

const clampV = v => Math.min(Math.max(v, 0), VTOTAL);
const anchorFrac = v => (VTOTAL > 0 ? clampV(v) / VTOTAL : 0);

// The display row (fractional) of one side at virtual position v.
function rowAt(v, side) {
  if (!VS.length) return 0;
  let lo = 0, hi = VS.length - 1;
  while (lo < hi) { const m = (lo + hi + 1) >> 1; if (VS[m][0] <= v) lo = m; else hi = m - 1; }
  const s = VS[lo], f = Math.min(Math.max((v - s[0]) / s[1], 0), 1);
  return side === "a" ? s[2] + f * (s[3] - s[2]) : s[4] + f * (s[5] - s[4]);
}

function topFor(pane, v) {
  return rowAt(v, pane === L ? "a" : "b") * LH - pane.clientHeight * anchorFrac(v);
}

// Alignment: clicking a block puts its left and right parts side by side. This needs
// an extra offset per pane. The offset is full at the aligned position and fades to
// zero as you scroll away, over one screen or more for far-apart blocks. Thus the
// panes return to normal sync and never race.
let align = null;  // {v, a, b, span}: aligned position, offsets in px, fade distance.

function offsetFor(pane, v) {
  if (!align) return 0;
  const k = Math.max(0, 1 - Math.abs(v - align.v) / align.span) * (align.k ?? 1);
  return (pane === L ? align.a : align.b) * k;
}

// True while an alignment offset moves the panes away from linked scrolling.
function isAligned() {
  return Math.abs(offsetFor(L, vNow)) > 0.5 || Math.abs(offsetFor(R, vNow)) > 0.5;
}

// Fade the alignment out, so that both panes return to linked scrolling.
function relink() {
  if (!align) return;
  align.kTarget = 0;
  if (!animating) { animating = true; lastT = performance.now(); requestAnimationFrame(step); }
}

function paneTop(pane, v) {
  return topFor(pane, v) + offsetFor(pane, v);
}

// Show display row ra (left) and rb (right) side by side, at one third of the height.
function alignRows(ra, rb) {
  const v = clampV((vOfRow(ra, "a") + vOfRow(rb, "b")) / 2);
  const y = L.clientHeight / 3;
  const a = ra * LH - y - topFor(L, v), b = rb * LH - y - topFor(R, v);
  const span = Math.max(L.clientHeight / LH, (2 * Math.max(Math.abs(a), Math.abs(b))) / LH);
  align = {v, a, b, span};
  scrollToV(v);
}

// The virtual position of a display row on one side.
function vOfRow(row, side) {
  for (const s of VS) {
    const r1 = side === "a" ? s[2] : s[4], r2 = side === "a" ? s[3] : s[5];
    if (r2 > r1 && row >= r1 && row < r2) return s[0] + ((row - r1) / (r2 - r1)) * s[1];
  }
  return row <= 0 ? 0 : VTOTAL;
}

// The virtual position of the end of display row row - 1 on one side. Unlike
// vOfRow(row), this does not skip the following rows of the other side only.
function vOfRowEnd(row, side) {
  for (const s of VS) {
    const r1 = side === "a" ? s[2] : s[4], r2 = side === "a" ? s[3] : s[5];
    if (r2 > r1 && row > r1 && row <= r2) return s[0] + ((row - r1) / (r2 - r1)) * s[1];
  }
  return row <= 0 ? 0 : VTOTAL;
}

// The virtual position that gives a pane a scroll position (scrollbars, keys, minimap).
// topFor() grows with v nearly everywhere, so a binary search is good enough.
function vForTop(pane, top, withOffset = true) {
  let lo = 0, hi = VTOTAL;
  for (let k = 0; k < 40; k++) {
    const m = (lo + hi) / 2;
    if ((withOffset ? paneTop(pane, m) : topFor(pane, m)) < top) lo = m; else hi = m;
  }
  return (lo + hi) / 2;
}

function setPaneTop(pane, top) {
  pane.scrollTop = top;
  expected.set(pane, pane.scrollTop);
}

// Put both panes (except "skip") at virtual position v.
function applyV(v, skip = null) {
  vNow = clampV(v);
  for (const p of [L, R]) if (p !== skip) setPaneTop(p, paneTop(p, vNow));
  requestDraw();
}

// Scroll to v, with a smooth easing animation unless "animate" is false.
// Two animation modes:
// - follow: exponential easing toward a target that can change (wheel, minimap drag).
// - tween: an ease-in-out curve for a jump longer than one screen. It starts slowly,
//   so the eye can follow the direction. The duration grows with the distance.
let tween = null;  // {from, to, t0, dur}
const easeInOut = p => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);

function scrollToV(v, animate = true, follow = false) {
  vTarget = clampV(v);
  if (!animate) { animating = false; tween = null; applyV(vTarget); return; }
  const screens = Math.abs(vTarget - vNow) / Math.max(L.clientHeight / LH, 1);
  if (!follow && screens > 1) {
    tween = {from: vNow, to: vTarget, t0: performance.now(), dur: 220 + 170 * Math.log2(1 + screens)};
  } else {
    tween = null;
  }
  if (!animating) { animating = true; lastT = performance.now(); requestAnimationFrame(step); }
}

function step() {
  if (!animating) return;
  // Use one clock. The frame timestamp and performance.now() can differ.
  const t = performance.now();
  const dt = Math.min(Math.max(t - lastT, 0), 100);
  lastT = t;
  const ease = 1 - Math.exp(-dt / EASE_MS);
  let v;
  if (tween) {
    const p = Math.min((t - tween.t0) / tween.dur, 1);
    v = tween.from + (tween.to - tween.from) * easeInOut(p);
    if (p >= 1) { v = tween.to; tween = null; }
  } else {
    // Limit the speed, so that a fast flick on the minimap glides instead of jumping.
    const maxStep = Math.max((L.clientHeight / LH) * FOLLOW_MAX_SCREENS * (dt / 16), 1);
    const step = Math.max(-maxStep, Math.min(maxStep, (vTarget - vNow) * ease));
    v = vNow + step;
    if (Math.abs(vTarget - v) < 0.02) v = vTarget;
  }
  if (align && align.kTarget !== undefined) {
    const k = align.k ?? 1;
    align.k = k + (align.kTarget - k) * ease;
    if (Math.abs(align.k - align.kTarget) < 0.005) align = null;
  }
  applyV(v);
  const fading = align && align.kTarget !== undefined;
  if (v !== vTarget || tween || fading) requestAnimationFrame(step); else animating = false;
}

// The mouse wheel moves the shared position at WHEEL_SPEED, with easing.
function onWheel(e) {
  if (!LY || e.ctrlKey || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;  // Zoom and sideways: browser.
  e.preventDefault();
  const px = e.deltaMode === 1 ? e.deltaY * LH : e.deltaMode === 2 ? e.deltaY * L.clientHeight : e.deltaY;
  scrollToV((animating ? vTarget : vNow) + (px * WHEEL_SPEED) / LH, true, true);
}
for (const el of [L, R, G]) el.addEventListener("wheel", onWheel, {passive: false});

function requestDraw() {
  if (drawPending) return;
  drawPending = true;
  requestAnimationFrame(() => { drawPending = false; draw(); });
}

function band(a1, a2, b1, b2, W) {
  const m = W / 2;
  return `M0 ${a1}C${m} ${a1} ${m} ${b1} ${W} ${b1}L${W} ${b2}C${m} ${b2} ${m} ${a2} 0 ${a2}Z`;
}

// Only the top and bottom curves of a band, for the outline. The vertical ends where
// a band meets a pane get no line.
function bandEdges(a1, a2, b1, b2, W) {
  const m = W / 2;
  return `M0 ${a1}C${m} ${a1} ${m} ${b1} ${W} ${b1}M0 ${a2}C${m} ${a2} ${m} ${b2} ${W} ${b2}`;
}

// A band is a group: the fill (no stroke) and the two edge curves (no fill).
function bandGroup(attrs, a1, a2, b1, b2, W, fillStyle = "", edgeStyle = "") {
  return `<g ${attrs}><path class="fill" d="${band(a1, a2, b1, b2, W)}"${fillStyle}/>` +
    `<path class="edge" d="${bandEdges(a1, a2, b1, b2, W)}"${edgeStyle}/></g>`;
}

function draw() {
  if (!LY) return;
  const W = G.clientWidth, H = G.clientHeight, lt = L.scrollTop, rt = R.scrollTop;
  let s = "";
  LY.dops.forEach(([t, a1r, a2r, b1r, b2r], k) => {
    if (t === "e") return;
    const a1 = a1r * LH - lt, a2 = a2r * LH - lt, b1 = b1r * LH - rt, b2 = b2r * LH - rt;
    if (Math.max(a2, b2) < 0 || Math.min(a1, b1) > H) return;
    s += bandGroup(`class="${t}${k === sel ? " sel" : ""}" data-k="${k}" data-ra="${a1r}" data-rb="${b1r}"`, a1, a2, b1, b2, W);
  });
  D.moves.forEach(([kind, sf, si, df, dj, na, nb], mid) => {
    if (sf !== cur || df !== cur) return;
    const a1 = LY.ya[si] * LH - lt, a2 = LY.ya[si + na] * LH - lt;
    const b1 = LY.yb[dj] * LH - rt, b2 = LY.yb[dj + nb] * LH - rt;
    if ((a2 < 0 && b2 < 0) || (a1 > H && b1 > H)) return;
    const h = hue(mid), dash = kind === "similar" ? ' stroke-dasharray="4 3"' : "";
    s += bandGroup(`class="mv" data-m="${mid}"`, a1, a2, b1, b2, W,
      ` fill="hsl(${h} 70% 55% / .28)"`, ` stroke="hsl(${h} 65% 45%)" stroke-width="1.5"${dash}`);
  });
  G.innerHTML = s;
  updateThumb();
  autoSelect();
}

for (const pane of [L, R]) {
  // Scrollbars, arrow keys, Page Up/Down: the browser scrolls one pane. Follow it.
  pane.addEventListener("scroll", () => {
    const other = pane === L ? R : L;
    if (other.scrollLeft !== pane.scrollLeft) other.scrollLeft = pane.scrollLeft;
    if (Math.abs(pane.scrollTop - (expected.get(pane) ?? -1e9)) <= 1) { requestDraw(); return; }
    animating = false;
    tween = null;
    expected.set(pane, pane.scrollTop);
    const v = vForTop(pane, pane.scrollTop);
    vTarget = v;
    applyV(v, pane);
  }, {passive: true});
  pane.addEventListener("click", e => {
    const num = e.target.closest(".r[data-i] > .n");
    if (num && D.pr) return openPrLine(pane === L ? "a" : "b", +num.parentElement.dataset.i, e.shiftKey, num);
    const fold = e.target.closest(".r.fold");
    if (fold) return openFold(fold, pane);
    const line = e.target.closest(".r[data-i]");
    if (line && D.review) {
      const side = pane === L ? "a" : "b", i = +line.dataset.i;
      const k = blockAt((side === "a" ? LY.ya : LY.yb)[i], side);
      if (k >= 0) select(k);
    }
    const row = e.target.closest(".r[data-m]");
    if (row) goToCounterpart(+row.dataset.m, pane === L ? "a" : "b");
  });
}
// The panes change size with the window, the split and the notes panel. The thumb and
// the alignment depend on the pane height, so recompute the positions.
new ResizeObserver(() => { if (LY) applyV(vNow); }).observe(L);

// Drag the gutter to the left or right to resize the panes. Double-click resets the split.
// A drag starts only after a few pixels, so a click on a band still aligns it.
const SPLIT_MIN = 0.15, SPLIT_MAX = 0.85;
function setSplit(f, save = true) {
  f = Math.min(SPLIT_MAX, Math.max(SPLIT_MIN, f));
  document.documentElement.style.setProperty("--lfr", `${f}fr`);
  document.documentElement.style.setProperty("--rfr", `${1 - f}fr`);
  if (save) try { localStorage.setItem("blockdiff.split", String(f)); } catch (e) { /* storage unavailable */ }
  if (LY) applyV(vNow);
}
try {
  const saved = parseFloat(localStorage.getItem("blockdiff.split"));
  if (saved > 0 && saved < 1) setSplit(saved, false);
} catch (e) { /* storage unavailable */ }
let split = null;  // {x0, dragging} while the pointer is down on the gutter
let suppressClick = false;
G.addEventListener("pointerdown", e => {
  if (e.button === 0) split = {x0: e.clientX, id: e.pointerId, dragging: false};
});
G.addEventListener("pointermove", e => {
  if (!split) return;
  if (!split.dragging) {
    if (Math.abs(e.clientX - split.x0) < 4) return;
    split.dragging = true;
    G.classList.add("resizing");
    try { G.setPointerCapture(split.id); } catch (err) { /* synthetic event */ }
  }
  const l = L.getBoundingClientRect(), r = R.getBoundingClientRect();
  const panes = l.width + r.width;
  if (panes > 0) setSplit((e.clientX - l.left - G.clientWidth / 2) / panes, false);
});
function endSplit() {
  if (!split) return;
  if (split.dragging) {
    suppressClick = true;
    setTimeout(() => { suppressClick = false; }, 0);
    G.classList.remove("resizing");
    const l = L.getBoundingClientRect().width, r = R.getBoundingClientRect().width;
    if (l + r > 0) setSplit(l / (l + r));
  }
  split = null;
}
G.addEventListener("pointerup", endSplit);
G.addEventListener("pointercancel", endSplit);
G.addEventListener("dblclick", () => setSplit(0.5));
// The click after a drag must not align a band.
G.addEventListener("click", e => {
  if (suppressClick) { suppressClick = false; e.stopImmediatePropagation(); }
}, true);

// Click a band in the gutter to align its left and right parts.
G.addEventListener("click", e => {
  const path = e.target.closest("g");
  if (!path || !LY) return;
  if (path.dataset.m !== undefined) {
    const [kind, sf, si, df, dj, na, nb] = D.moves[+path.dataset.m];
    alignRows(LY.ya[si], LY.yb[dj]);
    flash(L, si, na);
    flash(R, dj, nb);
    if (sf === cur) select(blockAt(LY.ya[si], "a"));
  } else if (path.dataset.ra !== undefined) {
    alignRows(+path.dataset.ra, +path.dataset.rb);
    select(+path.dataset.k);
  }
});

// ---------------------------------------------------------------- folding
function openFold(rowEl, pane) {
  const fo = LY.folds[rowEl.dataset.fold];
  const side = pane === L ? "a" : "b";
  const y = rowEl.offsetTop - pane.scrollTop;
  expanded.add(fo.key);
  render();
  // Keep the opened lines where the fold row was.
  const row = side === "a" ? LY.ya[fo.ia] : LY.yb[fo.ib];
  scrollToV(vForTop(pane, row * LH - y), false);
}

// The old-side line at the anchor of the left pane, to keep it in place.
function centerLine() {
  if (!LY || !LY.rowsA.length) return 0;
  const r = Math.max(0, Math.min(LY.rowsA.length - 1, Math.floor(rowAt(vNow, "a"))));
  const e = LY.rowsA[r];
  return typeof e === "number" ? e : e.ia;
}

function setFolding(on) {
  folding = on;
  try { localStorage.setItem("blockdiff.fold", on ? "1" : "0"); } catch (e) { /* storage unavailable */ }
  FOLDBTN.setAttribute("aria-pressed", String(on));
  FOLDBTN.textContent = (on ? "Show identical lines" : "Hide identical lines") + " (h)";
  if (cur < 0) return;
  const line = centerLine();
  expanded.clear();
  render();
  scrollToV(vOfRow(LY.ya[line], "a"), false);
}
FOLDBTN.addEventListener("click", () => setFolding(!folding));

// ---------------------------------------------------------------- theme
const THEMES = ["system", "dark", "light"];
const THEME_LABELS = {system: "System theme", dark: "Dark theme", light: "Light theme"};
const THEMEBTN = document.getElementById("themebtn");
let theme = document.documentElement.dataset.theme || "system";

function showTheme() {
  if (theme === "system") delete document.documentElement.dataset.theme;
  else document.documentElement.dataset.theme = theme;
  THEMEBTN.textContent = THEME_LABELS[theme] + " (t)";
  requestDraw();
}

function cycleTheme() {
  theme = THEMES[(THEMES.indexOf(theme) + 1) % THEMES.length];
  try { localStorage.setItem("blockdiff.theme", theme); } catch (e) { /* storage unavailable */ }
  showTheme();
}
THEMEBTN.addEventListener("click", cycleTheme);
showTheme();

// ---------------------------------------------------------------- navigation
function flash(pane, line, n) {
  for (let k = 0; k < n; k++) pane.querySelector(`.r[data-i="${line + k}"]`)?.classList.add("flash");
  setTimeout(() => pane.querySelectorAll(".flash").forEach(r => r.classList.remove("flash")), 1200);
}

function goToCounterpart(mid, side) {
  const [kind, sf, si, df, dj, na, nb] = D.moves[mid];
  const tf = side === "a" ? df : sf, tl = side === "a" ? dj : si, n = side === "a" ? nb : na;
  const target = side === "a" ? R : L, tside = side === "a" ? "b" : "a";
  if (tf === cur) {
    alignRows(LY.ya[si], LY.yb[dj]);
    flash(L, si, na);
    flash(R, dj, nb);
    return;
  }
  // The other copy is in another file: open it there.
  showFile(tf, false);
  const row = (tside === "a" ? LY.ya : LY.yb)[tl];
  scrollToV(vOfRow(row, tside) - CONTEXT_ABOVE, false);
  flash(target, tl, n);
}

function jumpChange(dir) {
  const now = animating ? vTarget : vNow;
  const starts = [];
  LY.dops.forEach((o, k) => { if (o[0] !== "e" && o[0] !== "f") starts.push([clampV(LY.dv[k] - CONTEXT_ABOVE), k]); });
  const hit = dir > 0 ? starts.find(([s]) => s > now + 0.5) : starts.slice().reverse().find(([s]) => s < now - 0.5);
  if (hit) { scrollToV(hit[0]); select(hit[1]); }
  else if (dir > 0 && cur < D.files.length - 1) showFile(cur + 1);
  else if (dir < 0 && cur > 0) showFile(cur - 1);
}

function nextFile(dir) {
  const i = cur + dir;
  if (i >= 0 && i < D.files.length) showFile(i);
}

// Keyboard shortcuts. Several common conventions are supported:
//   Meld / WinMerge / Araxis: Alt+Down, Alt+Up      VS Code: F7, Shift+F7
const KEYS = [
  [e => e.altKey && !e.shiftKey && e.key === "ArrowDown", () => jumpChange(1)],
  [e => e.altKey && !e.shiftKey && e.key === "ArrowUp", () => jumpChange(-1)],
  [e => e.altKey && e.shiftKey && e.key === "ArrowDown", () => nextFile(1)],
  [e => e.altKey && e.shiftKey && e.key === "ArrowUp", () => nextFile(-1)],
  [e => !e.altKey && !e.shiftKey && e.key === "F7", () => jumpChange(1)],
  [e => !e.altKey && e.shiftKey && e.key === "F7", () => jumpChange(-1)],
  [e => !e.altKey && e.key === "n", () => jumpChange(1)],
  [e => !e.altKey && e.key === "p", () => jumpChange(-1)],
  [e => !e.altKey && e.key === "j", () => nextFile(1)],
  [e => !e.altKey && e.key === "k", () => nextFile(-1)],
  [e => !e.altKey && e.key === "h", () => setFolding(!folding)],
  [e => e.key === "Escape" && isAligned(), () => relink()],
  [e => !e.altKey && e.key === "t", () => cycleTheme()],
  [e => !e.altKey && e.key === "r" && D.review, () => showNotes(!document.body.classList.contains("notes-on"))],
];

document.addEventListener("keydown", e => {
  if (e.ctrlKey || e.metaKey) return;
  const hit = KEYS.find(([match]) => match(e));
  if (hit) { e.preventDefault(); hit[1](); }
});

// Open a line, or with Shift a range from the last picked line, in the pull request on GitHub.
// GitHub names a line "diff-<SHA-256 of the path>" + "L" (old side) or "R" (new side) + number.
// The page opens in one reused tab. To comment, click the "+" next to the line there.
let prPick = null;  // {file, side, line, el}: the last picked line
function openPrLine(side, i, extend, el) {
  const f = D.files[cur], s = side === "a" ? "L" : "R";
  let a = i + 1, b = i + 1;
  if (extend && prPick && prPick.file === cur && prPick.side === side) {
    a = Math.min(prPick.line, i + 1);
    b = Math.max(prPick.line, i + 1);
  }
  prPick?.el?.classList.remove("picked");
  prPick = {file: cur, side, line: i + 1, el};
  el.classList.add("picked");
  const range = a === b ? `${s}${a}` : `${s}${a}-${s}${b}`;
  window.open(`${D.pr.url}/files#diff-${f.gh}${range}`, "blockdiff-pr");
}

// Open a file in VS Code at the first line that shows in the right pane.
// The vscode:// link needs VS Code as the handler of that URL scheme.
function openInEditor(i) {
  const f = D.files[i];
  let line = 1;
  if (i === cur && LY) {
    const j = LY.yb.findIndex(y => y * LH >= R.scrollTop);
    if (j >= 0 && j < f.b.length) line = j + 1;
  }
  const a = document.createElement("a");
  a.href = "vscode://file" + encodeURI(f.disk) + ":" + line;
  a.click();
}

// ---------------------------------------------------------------- review notes
// With --notes, a panel under the panes shows the notes of the selected change. A note
// marks line ranges on both sides. A change shows each note whose lines it overlaps.
// A click on a change or a jump selects it. After a scroll moves the selection off the
// screen, the change nearest to the anchor line becomes the selection.
let sel = -1;  // The selected change: an index into LY.dops, or -1.
let overviewOn = false, notesKey = null;
const NOTESBODY = document.getElementById("notesbody"), OVBTN = document.getElementById("ovbtn");
const notesOf = {};
if (D.review) for (const n of D.review.notes) if (n.file >= 0) (notesOf[n.file] ||= []).push(n);

const isChange = o => o[0] !== "e" && o[0] !== "f";

// The change that contains display row "row" of one side, or -1.
function blockAt(row, side) {
  return LY.dops.findIndex(o => isChange(o) && (side === "a" ? row >= o[1] && row < o[2] : row >= o[3] && row < o[4]));
}

function linesOf(k) {
  const [, a1, a2, b1, b2] = LY.dops[k];
  const pick = (rows, r1, r2) => rows.slice(r1, r2).filter(e => typeof e === "number");
  return {a: pick(LY.rowsA, a1, a2), b: pick(LY.rowsB, b1, b2)};
}

function notesFor(k) {
  if (k < 0 || !LY.dops[k]) return [];
  const {a, b} = linesOf(k);
  const hits = (ranges, lines) => lines.some(i => ranges.some(([s, e]) => i >= s && i < e));
  return (notesOf[cur] || []).filter(n => hits(n.a, a) || hits(n.b, b));
}

function select(k) {
  if (!D.review || !LY) return;
  sel = k;
  for (const el of document.querySelectorAll(".r.selr")) el.classList.remove("selr");
  if (k >= 0) {
    const {a, b} = linesOf(k);
    for (const i of a) L.querySelector(`.r[data-i="${i}"]`)?.classList.add("selr");
    for (const i of b) R.querySelector(`.r[data-i="${i}"]`)?.classList.add("selr");
  }
  requestDraw();
  updateNotes();
}

// Keep the selection while it shows on the screen. Otherwise select the change nearest
// to the anchor line. Not during an animation: a jump selects its target before it arrives.
function autoSelect() {
  if (!D.review || animating || !LY) return;
  const la = L.scrollTop / LH, lb = la + L.clientHeight / LH;
  const ra = R.scrollTop / LH, rb = ra + R.clientHeight / LH;
  const over = (s, e, lo, hi) => s < hi && Math.max(e, s + 0.01) > lo;
  const vis = o => over(o[1], o[2], la, lb) || over(o[3], o[4], ra, rb);
  if (sel >= 0 && LY.dops[sel] && vis(LY.dops[sel])) return;
  let best = -1, dist = Infinity;
  LY.dops.forEach((o, k) => {
    if (!isChange(o) || !vis(o)) return;
    const d = Math.min(Math.abs(vOfRow(o[1], "a") - vNow), Math.abs(vOfRow(o[3], "b") - vNow));
    if (d < dist) { dist = d; best = k; }
  });
  if (best !== sel) select(best);
}

const riskHtml = n => (n.risk ? `<span class="risk ${n.risk}">${n.risk}</span>` : "") +
  (n.exact ? "" : '<span class="fuzzy" title="The code changed after the report. The note matches similar lines.">approximate</span>');

function updateNotes() {
  if (!D.review) return;
  const list = overviewOn ? [] : notesFor(sel);
  const key = overviewOn ? "overview" : `${cur}:${sel < 0}:${list.map(n => D.review.notes.indexOf(n)).join(",")}`;
  if (key === notesKey) return;
  notesKey = key;
  const title = document.getElementById("notestitle");
  let h;
  if (overviewOn) {
    title.textContent = D.review.name;
    const lost = D.review.notes.filter(n => n.file < 0);
    h = `<div class="md">${D.review.overview}</div>` + (lost.length
      ? `<h3>Notes that match no change</h3>` + lost.map(n => `<div class="note md">${riskHtml(n)}${n.html}</div>`).join("")
      : "");
  } else if (list.length) {
    title.innerHTML = list.map(n => esc(n.title) + riskHtml(n)).join(" &nbsp;·&nbsp; ");
    h = list.map(n => `<div class="note md">${n.html}</div>`).join("");
  } else {
    title.textContent = pathOf(D.files[cur]);
    const intro = D.review.intros[cur];
    const msg = !notesOf[cur] ? "The report has no notes for this file."
      : sel >= 0 ? "The report has no note for this change." : "Select a change to see its note.";
    h = `<p class="none">${msg}</p>` + (intro ? `<div class="md">${intro}</div>` : "");
  }
  NOTESBODY.innerHTML = h;
  NOTESBODY.scrollTop = 0;
}

function showNotes(on, save = true) {
  document.body.classList.toggle("notes-on", on);
  document.getElementById("notesbtn").setAttribute("aria-pressed", String(on));
  if (save) try { localStorage.setItem("blockdiff.notes", on ? "1" : "0"); } catch (e) { /* storage unavailable */ }
}

OVBTN.addEventListener("click", () => {
  overviewOn = !overviewOn;
  OVBTN.setAttribute("aria-pressed", String(overviewOn));
  updateNotes();
});
document.getElementById("notesbtn").addEventListener("click", () => showNotes(!document.body.classList.contains("notes-on")));

// Drag the top edge of the panel to change its height.
const NOTES_MIN = 60;
function setNotesHeight(px, save = true) {
  px = Math.round(Math.min(Math.max(px, NOTES_MIN), window.innerHeight * 0.8));
  document.documentElement.style.setProperty("--notesh", px + "px");
  if (save) try { localStorage.setItem("blockdiff.notesh", String(px)); } catch (e) { /* storage unavailable */ }
}
{
  const grip = document.querySelector("#notes .grip");
  let y0 = null, h0 = 0;
  grip.addEventListener("pointerdown", e => {
    y0 = e.clientY;
    h0 = document.getElementById("notes").getBoundingClientRect().height;
    try { grip.setPointerCapture(e.pointerId); } catch (err) { /* synthetic event */ }
  });
  grip.addEventListener("pointermove", e => { if (y0 !== null) setNotesHeight(h0 + y0 - e.clientY, false); });
  const end = () => {
    if (y0 === null) return;
    y0 = null;
    setNotesHeight(document.getElementById("notes").getBoundingClientRect().height);
  };
  grip.addEventListener("pointerup", end);
  grip.addEventListener("pointercancel", end);
}

// Drag the left edge of the panel to the right. The value is "right" (under the right
// pane, so it follows the middle bar) or a fraction of the width under the panes.
const NOTES_EL = document.getElementById("notes"), NOTES_SNAP = 12, NOTES_LEFT_MAX = 0.8;
function setNotesLeft(x, save = true) {
  if (x !== "right") x = Math.min(Math.max(+x || 0, 0), NOTES_LEFT_MAX);
  NOTES_EL.classList.toggle("under-right", x === "right");
  NOTES_EL.classList.toggle("inset", x === "right" || x > 0);
  NOTES_EL.style.marginLeft = x === "right" ? "" : x * 100 + "%";
  if (save) try { localStorage.setItem("blockdiff.notesl", String(x)); } catch (e) { /* storage unavailable */ }
}
{
  const grip = NOTES_EL.querySelector(".lgrip");
  let dragging = false, last = 0;
  grip.addEventListener("pointerdown", e => {
    if (e.button !== 0) return;
    dragging = true;
    try { grip.setPointerCapture(e.pointerId); } catch (err) { /* synthetic event */ }
  });
  grip.addEventListener("pointermove", e => {
    if (!dragging) return;
    const x0 = L.getBoundingClientRect().left, w = document.getElementById("app").getBoundingClientRect().right - x0;
    const rx = R.getBoundingClientRect().left;
    if (Math.abs(e.clientX - rx) < NOTES_SNAP) last = "right";
    else if (e.clientX - x0 < NOTES_SNAP) last = 0;
    else last = (e.clientX - x0) / w;
    setNotesLeft(last, false);
  });
  const end = () => { if (dragging) { dragging = false; setNotesLeft(last); } };
  grip.addEventListener("pointerup", end);
  grip.addEventListener("pointercancel", end);
  grip.addEventListener("dblclick", () => setNotesLeft(0));
}

// ---------------------------------------------------------------- start
(function init() {
  const list = document.getElementById("files");
  document.getElementById("openbtn").addEventListener("click", () => openInEditor(cur));
  if (D.review) {
    let on = true, h = NaN, left = null;
    try {
      on = localStorage.getItem("blockdiff.notes") !== "0";
      h = parseFloat(localStorage.getItem("blockdiff.notesh"));
      left = localStorage.getItem("blockdiff.notesl");
    } catch (e) { /* storage unavailable */ }
    if (h > 0) setNotesHeight(h, false);
    if (left) setNotesLeft(left === "right" ? "right" : parseFloat(left), false);
    showNotes(on, false);
    document.getElementById("notesbtn").hidden = false;
    document.getElementById("rhelp").hidden = false;
    const n = D.review.notes.length, lost = D.review.notes.filter(x => x.file < 0).length;
    const count = document.getElementById("notescount");
    count.textContent = `${n} notes` + (lost ? ` · ${lost} match no change` : "");
    if (lost) count.title = "See Report overview";
  }
  if (D.pr) {
    document.body.classList.add("pr");
    const a = document.getElementById("prlink");
    a.href = D.pr.url + "/files";
    a.textContent = `PR #${D.pr.number}`;
    a.title = "Click a line number to open that line in this pull request. Shift+click selects a range.";
    a.hidden = false;
  }
  let adds = 0, dels = 0;
  D.files.forEach((f, i) => {
    const counts = {a: 0, d: 0, m: 0};
    for (const c of f.cb) if (c !== "e") counts.a++;
    for (const c of f.ca) if (c !== "e") counts.d++;
    counts.m = f.ma.length + f.mb.length;
    adds += counts.a; dels += counts.d;
    const p = pathOf(f), dir = p.includes("/") ? p.slice(0, p.lastIndexOf("/")) : "";
    const el = document.createElement("div");
    el.className = "fi";
    el.innerHTML = `<div><span class="st ${f.status}">${f.status}</span><span class="nm">${esc(base(p))}</span></div>` +
      `<div class="dir">${esc(dir)}</div>` +
      `<div class="cnt"><span class="p">+${counts.a}</span> <span class="m">−${counts.d}</span>` +
      (counts.m ? ` · ${counts.m} moved/similar block ends` : "") + `</div>`;
    el.addEventListener("click", () => { if (i !== cur) showFile(i); });
    if (f.disk) {
      el.title = "Double-click to open in VS Code";
      el.addEventListener("dblclick", () => openInEditor(i));
    }
    list.appendChild(el);
  });
  const kinds = {moved: 0, similar: 0, reindent: 0};
  for (const m of D.moves) kinds[m[0]]++;
  document.getElementById("summary").textContent =
    `${D.title} · ${D.files.length} files · +${adds} −${dels} · ` +
    `${kinds.moved} moved, ${kinds.similar} similar, ${kinds.reindent} re-indented blocks`;
  // Optional deep link: #f=<file index or path suffix>&l=<line on the left side>&fold=1
  const h = new URLSearchParams(location.hash.slice(1));
  if (h.has("fold")) folding = h.get("fold") === "1";
  FOLDBTN.setAttribute("aria-pressed", String(folding));
  FOLDBTN.textContent = (folding ? "Show identical lines" : "Hide identical lines") + " (h)";
  let fi = 0;
  if (h.has("f")) {
    const q = h.get("f");
    fi = /^\d+$/.test(q) ? +q : Math.max(0, D.files.findIndex(f => pathOf(f).endsWith(q)));
  }
  if (D.files.length) {
    showFile(Math.min(fi, D.files.length - 1), !h.has("l"));
    if (h.has("l")) {
      const line = Math.max(0, Math.min(+h.get("l") - 1, D.files[cur].a.length));
      scrollToV(vOfRow(LY.ya[line], "a") - CONTEXT_ABOVE, false);
    }
  }
})();
</script>
</body>
</html>
"""


def write_html(payload: dict, out: str) -> None:
    data = json.dumps(payload, separators=(",", ":")).replace("</", "<\\/")
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(HTML.replace("__DATA__", data))


def open_browser(path: str) -> str:
    """Open the page in Firefox if it is installed, otherwise in the default browser."""
    url = "file://" + os.path.abspath(path)
    firefox = shutil.which("firefox")
    if firefox:
        try:
            # Start a separate process so that blockdiff does not wait for the browser.
            subprocess.Popen(
                [firefox, url],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return "Firefox"
        except OSError:
            pass
    webbrowser.open(url)
    return "the default browser"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("revs", nargs="*", help="zero, one, or two revisions, or A..B / A...B")
    ap.add_argument("-C", dest="repo", default=".", help="repository path (default: current directory)")
    ap.add_argument("--dirs", nargs=2, metavar=("LEFT", "RIGHT"), help="compare two folders")
    ap.add_argument("-o", "--output", help="HTML output file (default: /tmp/blockdiff-<uid>/blockdiff.html)")
    ap.add_argument("--no-open", action="store_true", help="do not open the browser")
    ap.add_argument("--paths", nargs="*", default=[], help="limit the diff to these paths")
    ap.add_argument("--pr", help="GitHub pull request (number or URL) for the line links (default: the PR of the branch)")
    ap.add_argument("--no-pr", action="store_true", help="do not look up a GitHub pull request")
    ap.add_argument("--notes", metavar="REPORT.md", help="review report with a note per hunk, shown under the panes")
    args = ap.parse_args()
    pr_proc = None if args.no_pr else start_pr_lookup("." if args.dirs else args.repo, args.pr)

    if args.dirs:
        files = from_dirs(*args.dirs)
        title = f"{args.dirs[0]} → {args.dirs[1]}"
    else:
        revs = args.revs
        if len(revs) == 1 and "..." in revs[0]:
            a, b = revs[0].split("...", 1)
            old = run_git(args.repo, "merge-base", a or "HEAD", b or "HEAD").decode().strip()
            new: str | None = b or "HEAD"
            title = revs[0]
        elif len(revs) == 1 and ".." in revs[0]:
            a, b = revs[0].split("..", 1)
            old, new = a or "HEAD", b or "HEAD"
            title = revs[0]
        elif len(revs) == 2:
            old, new = revs
            title = f"{old} → {new}"
        elif len(revs) == 1:
            old, new = revs[0], None
            title = f"{old} → working tree"
        elif not revs:
            old, new = "HEAD", None
            title = "HEAD → working tree"
        else:
            ap.error("give at most two revisions")
        files = from_git(args.repo, old, new, args.paths)

    files.sort(key=lambda f: f.new_path or f.old_path or "")
    if not files:
        print("blockdiff: no differences", file=sys.stderr)
        return 0
    payload = build_payload(Analysis(files), title)
    payload["pr"] = finish_pr_lookup(pr_proc)
    payload["review"] = load_notes(args.notes, files) if args.notes else None
    out = args.output
    if not out:
        # Use a fixed file per user. Firefox gives each local file its own localStorage,
        # so a fixed path lets the page remember settings such as "hide identical lines".
        folder = os.path.join(tempfile.gettempdir(), f"blockdiff-{os.getuid()}")
        os.makedirs(folder, mode=0o700, exist_ok=True)
        out = os.path.join(folder, "blockdiff.html")
    write_html(payload, out)
    kinds = [m[0] for m in payload["moves"]]
    print(
        f"blockdiff: {len(files)} files, {kinds.count('moved')} moved, "
        f"{kinds.count('similar')} similar, {kinds.count('reindent')} re-indented blocks -> {out}"
    )
    if payload["pr"]:
        print(f"blockdiff: line numbers link to {payload['pr']['url']}")
    if payload["review"]:
        rv = payload["review"]
        fuzzy = sum(1 for n in rv["notes"] if n["file"] >= 0 and not n["exact"])
        print(f"blockdiff: {len(rv['notes'])} notes, {fuzzy} matched by similar lines, {len(rv['unmatched'])} not matched")
        for t in rv["unmatched"]:
            print(f"blockdiff:   not matched: {t}")
    if not args.no_open:
        print(f"blockdiff: opened in {open_browser(out)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
