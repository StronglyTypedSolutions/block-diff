header button[aria-pressed="true"] { background: var(--chg); border-color: var(--chg-s); }
.binary { padding: 20px; color: var(--dim); }
</style>
</head>
<body>
<div id="app">
  <header><b>blockdiff</b><span id="summary"></span>
    <button id="foldbtn" aria-pressed="false" title="Hide identical lines, keep 3 context lines (h)">Hide identical lines (h)</button>
    <span class="help">Alt+↓ / Alt+↑ or F7 / Shift+F7: next / previous change &nbsp; Alt+Shift+↓ / Alt+Shift+↑: next / previous file &nbsp; h: hide / show identical lines &nbsp; click a colored block: go to its counterpart</span></header>
  <div id="files"></div>
  <div class="ptitle" id="ltitle"></div><div class="gtitle"></div><div class="ptitle" id="rtitle"></div><div class="otitle"></div>
  <div class="pane" id="left"><div class="content" id="lc"></div></div>
  <svg id="gutter"></svg>
  <div class="pane" id="right"><div class="content" id="rc"></div></div>
  <div id="ov"></div>
</div>
<script id="data" type="application/json">__DATA__</script>
<script>
"use strict";
const D = JSON.parse(document.getElementById("data").textContent);
const LH = 18;   // Row height in pixels.
const CTX = 3;   // Context lines kept around each change when identical lines are hidden.
const L = document.getElementById("left"), R = document.getElementById("right");
const G = document.getElementById("gutter"), OV = document.getElementById("ov");
const FOLDBTN = document.getElementById("foldbtn");
let cur = -1, master = L, drawPending = false;
let LY = null;                 // Layout of the current file (see layout()).
const expanded = new Set();    // Folds that the user opened, as "file:line" keys.
let folding = false;
try { folding = localStorage.getItem("blockdiff.fold") === "1"; } catch (e) { /* storage unavailable */ }

const hue = id => (id * 137.508 + 25) % 360;
const esc = s => s.replace(/[&<>"]/g, c => ({"&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;"}[c]));
const pathOf = f => f.new || f.old;
const base = p => p.slice(p.lastIndexOf("/") + 1);

function lineHtml(text, spans) {
  if (!spans || !spans.length) return esc(text);
  let out = "", p = 0;
  for (const [s, e] of spans) { out += esc(text.slice(p, s)) + "<mark>" + esc(text.slice(s, e)) + "</mark>"; p = e; }
  return out + esc(text.slice(p));
}

function tagText(mid, side) {
  const [kind, sf, si, df, dj] = D.moves[mid];
  const otherFile = side === "a" ? df : sf, otherLine = (side === "a" ? dj : si) + 1;
  const where = otherFile === cur ? "line " + otherLine : base(pathOf(D.files[otherFile])) + ":" + otherLine;
  if (kind === "reindent") return "indentation changed";
  const edited = kind === "similar" ? " with changes" : "";
  return side === "a" ? `⇢ moved${edited} to ${where}` : `⇠ moved${edited} from ${where}`;
}

// ---------------------------------------------------------------- layout
// The layout maps file lines to display rows. When folding is on, each run of
// identical lines longer than the context becomes one fold row on both sides.
// Result: rowsA / rowsB (a line index, or a fold object per row), ya / yb (the row
// of each line, plus one entry for the end), and dops (the opcodes in row units).
function layout(f) {
  const rowsA = [], rowsB = [], folds = {};
  const ya = new Int32Array(f.a.length + 1), yb = new Int32Array(f.b.length + 1);
  const dops = [];
  const push = (t, i1, i2, j1, j2) => {
    const ra = rowsA.length, rb = rowsB.length;
    for (let i = i1; i < i2; i++) { ya[i] = rowsA.length; rowsA.push(i); }
    for (let j = j1; j < j2; j++) { yb[j] = rowsB.length; rowsB.push(j); }
    dops.push([t, ra, rowsA.length, rb, rowsB.length]);
  };
  f.ops.forEach(([t, i1, i2, j1, j2], k) => {
    if (t !== "e" || !folding) return push(t, i1, i2, j1, j2);
    const h1 = k === 0 ? i1 : i1 + CTX;
    const h2 = k === f.ops.length - 1 ? i2 : i2 - CTX;
    const key = cur + ":" + i1;
    if (h2 - h1 < 2 || expanded.has(key)) return push(t, i1, i2, j1, j2);
    const g1 = j1 + (h1 - i1), g2 = j1 + (h2 - i1);
    push("e", i1, h1, j1, g1);
    const fo = {key, n: h2 - h1, ia: h1, ib: g1};
    folds[key] = fo;
    for (let i = h1; i < h2; i++) ya[i] = rowsA.length;
    for (let j = g1; j < g2; j++) yb[j] = rowsB.length;
    dops.push(["f", rowsA.length, rowsA.length + 1, rowsB.length, rowsB.length + 1]);
    rowsA.push(fo);
    rowsB.push(fo);
    push("e", h2, i2, g2, j2);
  });
  ya[f.a.length] = rowsA.length;
  yb[f.b.length] = rowsB.length;
  return {rowsA, rowsB, ya, yb, dops, folds};
}

function buildSide(f, side) {
  const lines = f[side], cls = f["c" + side], spans = f["s" + side];
  const rowsIn = side === "a" ? LY.rowsA : LY.rowsB;
  const mv = new Int32Array(lines.length).fill(-1), first = new Set();
  for (const [s, n, mid] of f["m" + side]) { first.add(s); for (let k = 0; k < n; k++) mv[s + k] = mid; }
  const rows = [];
  for (const e of rowsIn) {
    if (typeof e !== "number") {
      rows.push(`<div class="r fold" data-fold="${e.key}" title="Click to show these lines"><span class="n">⋯</span><span class="t">⋯ ${e.n} identical lines</span></div>`);
      continue;
    }
    const i = e, m = mv[i];
    const attr = m >= 0 ? ` data-m="${m}" style="--h:${hue(m)}"` : "";
    const tag = m >= 0 && first.has(i) ? `<span class="tag">${esc(tagText(m, side))}</span>` : "";
    rows.push(`<div class="r ${cls[i]}" data-i="${i}"${attr}><span class="n">${i + 1}</span><span class="t">${lineHtml(lines[i], spans[i])}${tag}</span></div>`);
  }
  return rows.join("");
}

// Rebuild the panes of the current file. The caller sets the scroll position.
function render() {
  const f = D.files[cur];
  LY = layout(f);
  const lc = document.getElementById("lc"), rc = document.getElementById("rc");
  if (f.binary) {
    lc.innerHTML = rc.innerHTML = '<div class="binary">Binary file</div>';
  } else {
    lc.innerHTML = buildSide(f, "a");
    rc.innerHTML = buildSide(f, "b");
  }
  buildOverview(f);
}

function showFile(i, scrollToFirst = true) {
  cur = i;
  const f = D.files[i];
  document.querySelectorAll(".fi").forEach((el, k) => el.classList.toggle("cur", k === i));
  document.querySelector(".fi.cur")?.scrollIntoView({block: "nearest"});
  document.getElementById("ltitle").textContent = f.old || "(added)";
  document.getElementById("rtitle").textContent = f.new || "(deleted)";
  render();
  L.scrollTop = R.scrollTop = 0;
  if (scrollToFirst) {
    const op = LY.dops.find(o => o[0] !== "e" && o[0] !== "f");
    if (op) scrollPaneTo(L, op[1], 1 / 3);
  }
  master = L;
  sync(L);
}

// ---------------------------------------------------------------- minimap
// The left half shows the old file, the right half the new file.
function buildOverview(f) {
  const na = Math.max(LY.rowsA.length, 1), nb = Math.max(LY.rowsB.length, 1);
  const mk = (cls, side, r1, r2, n, extra = "") =>
    `<div class="mk ${side} ${cls}" style="top:${(r1 / n) * 100}%;height:${((r2 - r1) / n) * 100}%${extra}"></div>`;
  let h = "";
  for (const [t, a1, a2, b1, b2] of LY.dops) {
    if (t === "d" || t === "c") h += mk(t, "la", a1, a2, na);
    if (t === "a" || t === "c") h += mk(t, "rb", b1, b2, nb);
  }
  for (const [s, n, mid] of f.ma) h += mk("mv", "la", LY.ya[s], LY.ya[s + n], na, `;--h:${hue(mid)}`);
  for (const [s, n, mid] of f.mb) h += mk("mv", "rb", LY.yb[s], LY.yb[s + n], nb, `;--h:${hue(mid)}`);
  OV.innerHTML = h + '<div class="view" id="ovview"></div>';
}

function updateThumb() {
  const v = document.getElementById("ovview");
  if (!v || !LY) return;
  const total = Math.max(LY.rowsA.length, 1) * LH;
  v.style.top = Math.min(L.scrollTop / total, 1) * 100 + "%";
  v.style.height = Math.min(L.clientHeight / total, 1) * 100 + "%";
}

// Click on the minimap to jump there. Drag the thumb (or anywhere) to scroll.
let drag = null;
OV.addEventListener("pointerdown", e => {
  if (!LY) return;
  // Compute the thumb from the scroll position. The DOM thumb can lag one frame.
  const r = OV.getBoundingClientRect(), total = Math.max(LY.rowsA.length, 1) * LH;
  const vTop = r.top + Math.min(L.scrollTop / total, 1) * r.height;
  const vH = Math.min(L.clientHeight / total, 1) * r.height;
  const onThumb = e.clientY >= vTop && e.clientY <= vTop + Math.max(vH, 6);
  drag = {grab: onThumb ? e.clientY - vTop : vH / 2, top: r.top, height: r.height};
  try { OV.setPointerCapture(e.pointerId); } catch (err) { /* synthetic event */ }
  OV.classList.add("drag");
  dragTo(e.clientY);
  e.preventDefault();
});
OV.addEventListener("pointermove", e => { if (drag) dragTo(e.clientY); });
const endDrag = () => { drag = null; OV.classList.remove("drag"); };
OV.addEventListener("pointerup", endDrag);
OV.addEventListener("pointercancel", endDrag);

function dragTo(y) {
  const frac = (y - drag.grab - drag.top) / drag.height;
  L.scrollTop = frac * LY.rowsA.length * LH;
  master = L;
  sync(L);
}

// ---------------------------------------------------------------- scrolling
function mapRow(x, fromA) {
  let last = null;
  for (const [t, a1, a2, b1, b2] of LY.dops) {
    const s1 = fromA ? a1 : b1, s2 = fromA ? a2 : b2, d1 = fromA ? b1 : a1, d2 = fromA ? b2 : a2;
    last = [s2, d2];
    if (s2 > s1 && x >= s1 && x < s2) return d1 + ((x - s1) / (s2 - s1)) * (d2 - d1);
  }
  return last ? x - last[0] + last[1] : x;
}

function sync(from) {
  if (!LY) return;
  const other = from === L ? R : L;
  const c = (from.scrollTop + from.clientHeight / 2) / LH;
  other.scrollTop = mapRow(c, from === L) * LH - other.clientHeight / 2;
  other.scrollLeft = from.scrollLeft;
  requestDraw();
}

function scrollPaneTo(pane, row, frac) {
  pane.scrollTop = row * LH - pane.clientHeight * frac;
}

function requestDraw() {
  if (drawPending) return;
  drawPending = true;
  requestAnimationFrame(() => { drawPending = false; draw(); });
}

function band(a1, a2, b1, b2, W) {
  const m = W / 2;
  return `M0 ${a1}C${m} ${a1} ${m} ${b1} ${W} ${b1}L${W} ${b2}C${m} ${b2} ${m} ${a2} 0 ${a2}Z`;
}

function draw() {
  if (!LY) return;
  const W = G.clientWidth, H = G.clientHeight, lt = L.scrollTop, rt = R.scrollTop;
  let s = "";
  for (const [t, a1r, a2r, b1r, b2r] of LY.dops) {
    if (t === "e") continue;
    const a1 = a1r * LH - lt, a2 = a2r * LH - lt, b1 = b1r * LH - rt, b2 = b2r * LH - rt;
    if (Math.max(a2, b2) < 0 || Math.min(a1, b1) > H) continue;
    s += `<path class="${t}" d="${band(a1, a2, b1, b2, W)}"/>`;
  }
  D.moves.forEach(([kind, sf, si, df, dj, na, nb], mid) => {
    if (sf !== cur || df !== cur) return;
    const a1 = LY.ya[si] * LH - lt, a2 = LY.ya[si + na] * LH - lt;
    const b1 = LY.yb[dj] * LH - rt, b2 = LY.yb[dj + nb] * LH - rt;
    if ((a2 < 0 && b2 < 0) || (a1 > H && b1 > H)) return;
    const h = hue(mid), dash = kind === "similar" ? ' stroke-dasharray="4 3"' : "";
    s += `<path d="${band(a1, a2, b1, b2, W)}" fill="hsl(${h} 70% 55% / .28)" stroke="hsl(${h} 65% 45%)" stroke-width="1.5"${dash}/>`;
  });
  G.innerHTML = s;
  updateThumb();
}

for (const pane of [L, R]) {
  for (const ev of ["wheel", "mousedown", "touchstart", "keydown"]) {
    pane.addEventListener(ev, () => { master = pane; }, {passive: true});
  }
  pane.addEventListener("scroll", () => { if (pane === master) sync(pane); else requestDraw(); }, {passive: true});
  pane.addEventListener("click", e => {
    const fold = e.target.closest(".r.fold");
    if (fold) return openFold(fold, pane);
    const row = e.target.closest(".r[data-m]");
    if (row) goToCounterpart(+row.dataset.m, pane === L ? "a" : "b");
  });
}
window.addEventListener("resize", requestDraw);

// ---------------------------------------------------------------- folding
function openFold(rowEl, pane) {
  const fo = LY.folds[rowEl.dataset.fold];
  const y = rowEl.offsetTop - pane.scrollTop;
  expanded.add(fo.key);
  render();
  pane.scrollTop = (pane === L ? LY.ya[fo.ia] : LY.yb[fo.ib]) * LH - y;
  master = pane;
  sync(pane);
}

// The old-side line at the middle of the left pane, to keep it in place.
function centerLine() {
  if (!LY || !LY.rowsA.length) return 0;
  const r = Math.max(0, Math.min(LY.rowsA.length - 1, Math.floor((L.scrollTop + L.clientHeight / 2) / LH)));
  const e = LY.rowsA[r];
  return typeof e === "number" ? e : e.ia;
}

function setFolding(on) {
  folding = on;
  try { localStorage.setItem("blockdiff.fold", on ? "1" : "0"); } catch (e) { /* storage unavailable */ }
  FOLDBTN.setAttribute("aria-pressed", String(on));
  FOLDBTN.textContent = (on ? "Show identical lines" : "Hide identical lines") + " (h)";
  if (cur < 0) return;
  const line = centerLine();
  expanded.clear();
  render();
  scrollPaneTo(L, LY.ya[line], 0.5);
  master = L;
  sync(L);
}
FOLDBTN.addEventListener("click", () => setFolding(!folding));

// ---------------------------------------------------------------- navigation
function flash(pane, line, n) {
  for (let k = 0; k < n; k++) pane.querySelector(`.r[data-i="${line + k}"]`)?.classList.add("flash");
  setTimeout(() => pane.querySelectorAll(".flash").forEach(r => r.classList.remove("flash")), 1200);
}

function goToCounterpart(mid, side) {
  const [kind, sf, si, df, dj, na, nb] = D.moves[mid];
  const tf = side === "a" ? df : sf, tl = side === "a" ? dj : si, n = side === "a" ? nb : na;
  const target = side === "a" ? R : L;
  if (tf !== cur) {
    showFile(tf, false);
    scrollPaneTo(target, (side === "a" ? LY.yb : LY.ya)[tl], 1 / 3);
    master = target;
    sync(target);
  } else {
    const src = side === "a" ? L : R;
    const srcRow = side === "a" ? LY.ya[si] : LY.yb[dj];
    const y = srcRow * LH - src.scrollTop;
    target.scrollTop = (side === "a" ? LY.yb[dj] : LY.ya[si]) * LH - y;
    requestDraw();
  }
  flash(target, tl, n);
}

function jumpChange(dir) {
  const c = (L.scrollTop + L.clientHeight / 3) / LH;
  const ch = LY.dops.filter(o => o[0] !== "e" && o[0] !== "f");
  const op = dir > 0 ? ch.find(o => o[1] > c + 0.5) : ch.slice().reverse().find(o => o[1] < c - 0.5);
  if (op) { scrollPaneTo(L, op[1], 1 / 3); master = L; sync(L); }
  else if (dir > 0 && cur < D.files.length - 1) showFile(cur + 1);
  else if (dir < 0 && cur > 0) showFile(cur - 1);
}

function nextFile(dir) {
  const i = cur + dir;
  if (i >= 0 && i < D.files.length) showFile(i);
}

// Keyboard shortcuts. Several common conventions are supported:
//   Meld / WinMerge / Araxis: Alt+Down, Alt+Up      VS Code: F7, Shift+F7
const KEYS = [
  [e => e.altKey && !e.shiftKey && e.key === "ArrowDown", () => jumpChange(1)],
  [e => e.altKey && !e.shiftKey && e.key === "ArrowUp", () => jumpChange(-1)],
  [e => e.altKey && e.shiftKey && e.key === "ArrowDown", () => nextFile(1)],
  [e => e.altKey && e.shiftKey && e.key === "ArrowUp", () => nextFile(-1)],
  [e => !e.altKey && !e.shiftKey && e.key === "F7", () => jumpChange(1)],
  [e => !e.altKey && e.shiftKey && e.key === "F7", () => jumpChange(-1)],
  [e => !e.altKey && e.key === "n", () => jumpChange(1)],
  [e => !e.altKey && e.key === "p", () => jumpChange(-1)],
  [e => !e.altKey && e.key === "j", () => nextFile(1)],
  [e => !e.altKey && e.key === "k", () => nextFile(-1)],
  [e => !e.altKey && e.key === "h", () => setFolding(!folding)],
];

document.addEventListener("keydown", e => {
  if (e.ctrlKey || e.metaKey) return;
  const hit = KEYS.find(([match]) => match(e));
  if (hit) { e.preventDefault(); hit[1](); }
});

// ---------------------------------------------------------------- start
(function init() {
  const list = document.getElementById("files");
  let adds = 0, dels = 0;
  D.files.forEach((f, i) => {
    const counts = {a: 0, d: 0, m: 0};
    for (const c of f.cb) if (c !== "e") counts.a++;
    for (const c of f.ca) if (c !== "e") counts.d++;
    counts.m = f.ma.length + f.mb.length;
    adds += counts.a; dels += counts.d;
    const p = pathOf(f), dir = p.includes("/") ? p.slice(0, p.lastIndexOf("/")) : "";
    const el = document.createElement("div");
    el.className = "fi";
    el.innerHTML = `<div><span class="st ${f.status}">${f.status}</span><span class="nm">${esc(base(p))}</span></div>` +
      `<div class="dir">${esc(dir)}</div>` +
      `<div class="cnt"><span class="p">+${counts.a}</span> <span class="m">−${counts.d}</span>` +
      (counts.m ? ` · ${counts.m} moved/similar block ends` : "") + `</div>`;
    el.addEventListener("click", () => showFile(i));
    list.appendChild(el);
  });
  const kinds = {moved: 0, similar: 0, reindent: 0};
  for (const m of D.moves) kinds[m[0]]++;
  document.getElementById("summary").textContent =
    `${D.title} · ${D.files.length} files · +${adds} −${dels} · ` +
    `${kinds.moved} moved, ${kinds.similar} similar, ${kinds.reindent} re-indented blocks`;
  // Optional deep link: #f=<file index or path suffix>&l=<line on the left side>&fold=1
  const h = new URLSearchParams(location.hash.slice(1));
  if (h.has("fold")) folding = h.get("fold") === "1";
  FOLDBTN.setAttribute("aria-pressed", String(folding));
  FOLDBTN.textContent = (folding ? "Show identical lines" : "Hide identical lines") + " (h)";
  let fi = 0;
  if (h.has("f")) {
    const q = h.get("f");
    fi = /^\d+$/.test(q) ? +q : Math.max(0, D.files.findIndex(f => pathOf(f).endsWith(q)));
  }
  if (D.files.length) {
    showFile(Math.min(fi, D.files.length - 1), !h.has("l"));
    if (h.has("l")) {
      const line = Math.max(0, Math.min(+h.get("l") - 1, D.files[cur].a.length));
      scrollPaneTo(L, LY.ya[line], 1 / 3);
      master = L;
      sync(L);
    }
  }
})();
</script>
</body>
</html>
"""


def write_html(payload: dict, out: str) -> None:
    data = json.dumps(payload, separators=(",", ":")).replace("</", "<\\/")
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(HTML.replace("__DATA__", data))


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("revs", nargs="*", help="zero, one, or two revisions, or A..B / A...B")
    ap.add_argument("-C", dest="repo", default=".", help="repository path (default: current directory)")
    ap.add_argument("--dirs", nargs=2, metavar=("LEFT", "RIGHT"), help="compare two folders")
    ap.add_argument("-o", "--output", help="HTML output file (default: a temporary file)")
    ap.add_argument("--no-open", action="store_true", help="do not open the browser")
    ap.add_argument("--paths", nargs="*", default=[], help="limit the diff to these paths")
    args = ap.parse_args()

    if args.dirs:
        files = from_dirs(*args.dirs)
        title = f"{args.dirs[0]} → {args.dirs[1]}"
    else:
        revs = args.revs
        if len(revs) == 1 and "..." in revs[0]:
            a, b = revs[0].split("...", 1)
            old = run_git(args.repo, "merge-base", a or "HEAD", b or "HEAD").decode().strip()
            new: str | None = b or "HEAD"
            title = revs[0]
        elif len(revs) == 1 and ".." in revs[0]:
            a, b = revs[0].split("..", 1)
            old, new = a or "HEAD", b or "HEAD"
            title = revs[0]
        elif len(revs) == 2:
            old, new = revs
            title = f"{old} → {new}"
        elif len(revs) == 1:
            old, new = revs[0], None
            title = f"{old} → working tree"
        elif not revs:
            old, new = "HEAD", None
            title = "HEAD → working tree"
        else:
            ap.error("give at most two revisions")
        files = from_git(args.repo, old, new, args.paths)

    files.sort(key=lambda f: f.new_path or f.old_path or "")
    if not files:
        print("blockdiff: no differences", file=sys.stderr)
        return 0
    payload = build_payload(Analysis(files), title)
    out = args.output
    if not out:
        fd, out = tempfile.mkstemp(prefix="blockdiff-", suffix=".html")
        os.close(fd)
    write_html(payload, out)
    kinds = [m[0] for m in payload["moves"]]
    print(
        f"blockdiff: {len(files)} files, {kinds.count('moved')} moved, "
        f"{kinds.count('similar')} similar, {kinds.count('reindent')} re-indented blocks -> {out}"
    )
    if not args.no_open:
        webbrowser.open("file://" + os.path.abspath(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
