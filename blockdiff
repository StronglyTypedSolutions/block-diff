.r.d { background: var(--del); } .r.a { background: var(--add); } .r.c { background: var(--chg); }
.r.m, .r.s, .r.w { background: hsl(var(--h) var(--mv-s) var(--mv-l)); cursor: pointer; }
/* Changed lines inside a block that moved with changes. */
.r.s { background: hsl(var(--h) var(--mv-s) calc(var(--mv-l) - 7%)); }
.r.s .t { box-shadow: inset 4px 0 hsl(var(--h) 70% 40%); }
.r.w { background: hsl(var(--h) 30% var(--mv-l)); }
.r.flash { outline: 2px solid hsl(var(--h, 210) 70% 50%); outline-offset: -2px; }
/* Syntax colors. Diff colors are backgrounds, so they combine with these text colors. */
.kk { color: var(--syn-k); } .ks { color: var(--syn-s); } .kn { color: var(--syn-n); }
.kc { color: var(--syn-c); font-style: italic; } .kb { color: var(--syn-b); }
.kf { color: var(--syn-f); } .kd { color: var(--syn-d); }
/* Word changes: removed words on the left (red), added words on the right (green). */
mark { color: inherit; border-radius: 2px; }
#left mark { background: var(--mark-del); }
#right mark { background: var(--mark-add); }
/* Sticky: the label stays visible at the right edge, also after a long line. */
.tag { position: sticky; right: 6px; display: inline-block; line-height: 17px; margin-left: 2em; padding: 0 7px; border-radius: 9px; font: 11px system-ui, sans-serif;
  color: #fff; background: hsl(var(--h) 60% var(--tag-l)); }
#gutter { display: block; width: 100%; height: 100%; border-left: 1px solid var(--line);
  border-right: 1px solid var(--line); cursor: col-resize; touch-action: none; }
#gutter.resizing, #gutter.resizing g { cursor: col-resize; }
#gutter g { cursor: pointer; }
#gutter .fill { stroke: none; }
#gutter .edge { fill: none; stroke-width: 1; pointer-events: none; }
#gutter g:hover .edge { stroke-width: 2.5; }
#gutter g.mv:hover .edge { stroke-width: 3; }
#gutter .d .fill { fill: var(--del); } #gutter .d .edge { stroke: var(--del-s); }
#gutter .a .fill { fill: var(--add); } #gutter .a .edge { stroke: var(--add-s); }
#gutter .c .fill { fill: var(--chg); } #gutter .c .edge { stroke: var(--chg-s); }
#gutter .f .fill { fill: var(--panel); } #gutter .f .edge { stroke: var(--line); }
#ov { position: relative; border-left: 1px solid var(--line); background: var(--panel); cursor: pointer;
  touch-action: none; user-select: none; }
#ov::after { content: ""; position: absolute; left: 50%; top: 0; bottom: 0; border-left: 1px dashed var(--line); }
#ov .mk { position: absolute; min-height: 2px; }
#ov .mk.la { left: 3px; width: calc(50% - 5px); } #ov .mk.rb { right: 3px; width: calc(50% - 5px); }
#ov .d { background: var(--del-s); } #ov .a { background: var(--add-s); } #ov .c { background: var(--chg-s); }
#ov .mv { background: hsl(var(--h) 60% 50%); }
/* The thumb: a frame at the shared scroll position, with one view per half. Each view
   shows the rows of its pane. A view can reach past the frame when its pane shows rows
   from both sides of a long insertion on the other side. */
#ov .view { position: absolute; left: 0; right: 0; z-index: 1; min-height: 6px; border: 1px solid var(--dim);
  border-radius: 3px; background: rgba(128, 128, 128, .08); cursor: grab; }
#ov.drag .view { cursor: grabbing; background: rgba(128, 128, 128, .16); }
#ov .pv { position: absolute; z-index: 2; min-height: 4px; border-radius: 2px; pointer-events: none;
  background: var(--pv); box-shadow: inset 0 0 0 1px var(--pv-edge); }
#ov .pv.l { left: 2px; width: calc(50% - 3px); } #ov .pv.r { right: 2px; width: calc(50% - 3px); }
/* While blocks are aligned, the panes have different offsets, so one thumb cannot
   show both. A link button replaces the thumb and restores linked scrolling. */
#ov .relink { position: absolute; left: 50%; top: clamp(17px, var(--pos, 0%), calc(100% - 17px));
  transform: translate(-50%, -50%); z-index: 2; width: 32px; height: 32px; padding: 0;
  display: none; align-items: center; justify-content: center; cursor: pointer; border-radius: 50%;
  border: 1px solid var(--chg-s); background: var(--bg); color: var(--chg-s); }
#ov .relink:hover { background: var(--chg); }
#ov.aligned .relink { display: flex; }
#ov.aligned .view { display: none; }
.r.fold { background: var(--panel); color: var(--dim); cursor: pointer; font-style: italic; }
.r.fold:hover { color: var(--fg); }
header button { white-space: nowrap; font: inherit; font-size: 12px; padding: 2px 10px; border-radius: 6px; cursor: pointer;
  border: 1px solid var(--line); background: var(--bg); color: var(--fg); }
header button[aria-pressed="true"] { background: var(--chg); border-color: var(--chg-s); }
/* Review notes: a panel under the panes with the note of the selected change. */
#notes { grid-column: 2 / -1; display: none; flex-direction: column; position: relative; min-height: 0;
  height: var(--notesh, 32vh); border-top: 1px solid var(--line); background: var(--bg); }
body.notes-on #notes { display: flex; }
#notes .grip { position: absolute; left: 0; right: 0; top: -4px; height: 8px; z-index: 3; cursor: row-resize; touch-action: none; }
#notes .lgrip { position: absolute; top: 0; bottom: 0; left: -4px; width: 8px; z-index: 4; cursor: col-resize; touch-action: none; }
/* The left edge can move to the right. Under the right pane, the panel follows the middle bar. */
#notes.inset { border-left: 1px solid var(--line); }
#notes.under-right { grid-column: 4 / -1; margin-left: 0 !important; }
#notes .bar { display: flex; gap: 10px; align-items: center; padding: 4px 12px; font-size: 12px;
  background: var(--panel); border-bottom: 1px solid var(--line); white-space: nowrap; }
#notestitle { min-width: 0; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
#notescount { margin-left: auto; color: var(--dim); }
#notes button { font: inherit; padding: 1px 10px; border-radius: 6px; cursor: pointer;
  border: 1px solid var(--line); background: var(--bg); color: var(--fg); }
#notes button[aria-pressed="true"] { background: var(--chg); border-color: var(--chg-s); }
#notesbody { flex: 1; overflow: auto; padding: 2px 16px 16px; }
#notesbody .none { color: var(--dim); font-style: italic; }
.note + .note { border-top: 1px dashed var(--line); margin-top: 14px; }
.md { font-size: 13.5px; line-height: 1.5; }
.md h1, .md h2, .md h3, .md h4, .md h5, .md h6 { font-size: 15px; margin: 12px 0 4px; }
.md h1, .md h2 { font-size: 16px; }
.md p, .md ul, .md ol { margin: 6px 0; }
.md code { font: 12.5px "JetBrains Mono", monospace; background: var(--panel); padding: 0 3px; border-radius: 3px; }
.md pre { background: var(--panel); padding: 8px 10px; overflow: auto; font: 12.5px/1.45 "JetBrains Mono", monospace; border-radius: 4px; }
.md pre code { background: none; padding: 0; }
.md table { border-collapse: collapse; margin: 6px 0; }
.md th, .md td { border: 1px solid var(--line); padding: 3px 8px; text-align: left; vertical-align: top; }
.md th { background: var(--panel); }
.md a { color: var(--chg-s); }
.md details.hunk { margin: 6px 0; }
.md details.hunk summary { cursor: pointer; color: var(--dim); font-size: 12px; }
.md .da { color: var(--add-s); } .md .dd { color: var(--del-s); } .md .dh { color: var(--chg-s); }
.risk { display: inline-block; margin-left: 6px; padding: 0 7px; border-radius: 9px; font-size: 11px; font-weight: 700;
  line-height: 16px; border: 1px solid currentColor; }
.risk.High { color: var(--del-s); } .risk.Medium { color: var(--risk-m); } .risk.Low { color: var(--dim); }
.fuzzy { color: var(--risk-m); font-weight: 400; margin-left: 6px; }
/* The selected change: its line numbers and its band in the gutter. */
.r.selr .n { background: var(--cur); color: var(--fg); font-weight: 700; }
#gutter g.sel .edge { stroke-width: 2.5; }
.binary { padding: 20px; color: var(--dim); }
</style>
