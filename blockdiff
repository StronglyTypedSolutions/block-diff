# Detection thresholds.
MIN_MOVE_ALNUM = 20  # Same minimum as "git diff --color-moved".
MIN_MOVE_ALNUM_SINGLE_LINE = 50  # A one-line move must be longer to count.
SIM_START = 0.6  # Token similarity that starts a similar block.
SIM_LINE = 0.5  # Token similarity that continues a similar block.
MIN_SIM_LINES = 3  # Minimum number of similar non-blank lines in a similar block.
MAX_CANDIDATES = 64

TOKEN_RE = re.compile(r"[A-Za-z_]\w*|\d+|\S")
SPAN_TOKEN_RE = re.compile(r"\w+|\s+|[^\w\s]")


@dataclass
class FileDiff:
    status: str
    old_path: str | None
    new_path: str | None
    a: list[str]
    b: list[str]
    binary: bool = False
    disk: str | None = None  # The file on disk that an editor can open, if there is one.
    opcodes: list[tuple[str, int, int, int, int]] = field(default_factory=list)


# --------------------------------------------------------------------------- input


def run_git(repo: str, *args: str) -> bytes:
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, check=True).stdout


def to_lines(data: bytes | None) -> tuple[list[str], bool]:
    if data is None:
        return [], False
    if b"\0" in data[:8192]:
        return [], True
    return data.decode("utf-8", "replace").expandtabs(4).splitlines(), False


def git_show(repo: str, rev: str, path: str) -> bytes | None:
    try:
        return run_git(repo, "show", f"{rev}:{path}")
    except subprocess.CalledProcessError:
        return None


def from_git(repo: str, old: str, new: str | None, paths: list[str]) -> list[FileDiff]:
    top = run_git(repo, "rev-parse", "--show-toplevel").decode().strip()
    cmd = ["diff", "--name-status", "-z", "-M", old] + ([new] if new else []) + ["--", *paths]
    parts = run_git(top, *cmd).decode().split("\0")
    files = []
    i = 0
    while i < len(parts) - 1:
        status = parts[i][0]
        i += 1
        if status in "RC":
            old_path, new_path = parts[i], parts[i + 1]
            i += 2
        else:
            old_path = new_path = parts[i]
            i += 1
        old_data = None if status == "A" else git_show(top, old, old_path)
        if status == "D":
            new_data = None
        elif new is None:
            with open(os.path.join(top, new_path), "rb") as fh:
                new_data = fh.read()
        else:
            new_data = git_show(top, new, new_path)
        a, bin_a = to_lines(old_data)
        b, bin_b = to_lines(new_data)
        disk = os.path.join(top, new_path)
        files.append(
            FileDiff(
                status,
                None if status == "A" else old_path,
                None if status == "D" else new_path,
                a,
                b,
                bin_a or bin_b,
                disk if os.path.isfile(disk) else None,
            )
        )
    return files


def from_dirs(left: str, right: str) -> list[FileDiff]:
    def walk(root: str) -> set[str]:
        out = set()
        for base, _dirs, names in os.walk(root, followlinks=True):
            for name in names:
                out.add(os.path.relpath(os.path.join(base, name), root))
        return out

    def read(root: str, rel: str) -> bytes | None:
        path = os.path.join(root, rel)
        if not os.path.isfile(path):
            return None
        with open(path, "rb") as fh:
            return fh.read()

    files = []
    for rel in sorted(walk(left) | walk(right)):
        old_data, new_data = read(left, rel), read(right, rel)
        if old_data == new_data:
            continue
        status = "A" if old_data is None else "D" if new_data is None else "M"
        a, bin_a = to_lines(old_data)
        b, bin_b = to_lines(new_data)
        # git difftool --dir-diff links working tree files into its temporary folder.
        # realpath() gives the working tree file, which stays after the call.
        # Other files in that folder are copies that git deletes after the call.
        disk = os.path.realpath(os.path.join(right, rel))
        if "/git-difftool." in disk:
            disk = ""
        files.append(
            FileDiff(
                status,
                None if status == "A" else rel,
                None if status == "D" else rel,
                a,
                b,
                bin_a or bin_b,
                disk if os.path.isfile(disk) else None,
            )
        )
    return files


# ----------------------------------------------------------------------- analysis


def norm(line: str) -> str:
    return " ".join(line.split())


def alnum(line: str) -> int:
    return sum(c.isalnum() for c in line)


def token_ratio(x: list[str], y: list[str]) -> float:
    sm = difflib.SequenceMatcher(None, x, y, autojunk=False)
    if sm.real_quick_ratio() < SIM_LINE or sm.quick_ratio() < SIM_LINE:
        return 0.0
    return sm.ratio()


# --------------------------------------------------------------- syntax colors

PY_BUILTINS = set(dir(builtins)) | {"self", "cls"}
PY_STRING_TOKENS = {tokenize.STRING} | {
    getattr(tokenize, n) for n in ("FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END") if hasattr(tokenize, n)
}


def python_syntax(lines: list[str]) -> dict[int, list[list]]:
    """Return syntax ranges per line: {line: [[start, end, class], ...]}.

    Classes: "k" keyword, "s" string, "c" comment, "n" number, "b" builtin,
    "f" function or class name, "d" decorator. When the code does not tokenize,
    the function returns the ranges found up to the error.
    """
    out: dict[int, list[list]] = {}

    def add(start: tuple[int, int], end: tuple[int, int], cls: str) -> None:
        (r1, c1), (r2, c2) = start, end
        for r in range(r1, r2 + 1):
            if r - 1 >= len(lines):
                break
            s = c1 if r == r1 else 0
            e = c2 if r == r2 else len(lines[r - 1])
            if e > s:
                out.setdefault(r - 1, []).append([s, e, cls])

    source = "\n".join(lines) + "\n"
    prev = None  # Previous significant token.
    try:
        for tok in tokenize.generate_tokens(io.StringIO(source).readline):
            typ, text = tok.type, tok.string
            if typ == tokenize.COMMENT:
                add(tok.start, tok.end, "c")
            elif typ in PY_STRING_TOKENS:
                add(tok.start, tok.end, "s")
            elif typ == tokenize.NUMBER:
                add(tok.start, tok.end, "n")
            elif typ == tokenize.NAME:
                if prev is not None and prev.type == tokenize.NAME and prev.string in ("def", "class"):
                    add(tok.start, tok.end, "f")
                elif prev is not None and prev.type == tokenize.OP and prev.string == "@":
                    add(tok.start, tok.end, "d")
                elif keyword.iskeyword(text):
                    add(tok.start, tok.end, "k")
                elif text in PY_BUILTINS and not (prev is not None and prev.string == "."):
                    add(tok.start, tok.end, "b")
            elif typ == tokenize.OP and text == "@" and (prev is None or prev.type in (tokenize.NEWLINE, tokenize.NL, tokenize.INDENT, tokenize.DEDENT)):
                add(tok.start, tok.end, "d")
            if typ not in (tokenize.NL, tokenize.COMMENT):
                prev = tok
    except (tokenize.TokenError, SyntaxError):
        pass
    return out


def syntax_for(path: str | None, lines: list[str]) -> dict[int, list[list]]:
    if path and path.endswith((".py", ".pyi")):
        return python_syntax(lines)
    return {}


def change_spans(x: str, y: str) -> tuple[list[list[int]], list[list[int]]]:
    """Return the character ranges that differ between two paired lines."""
    tx, ty = SPAN_TOKEN_RE.findall(x), SPAN_TOKEN_RE.findall(y)
    px = [0]
    for t in tx:
        px.append(px[-1] + len(t))
    py = [0]
    for t in ty:
        py.append(py[-1] + len(t))
    sx: list[list[int]] = []
    sy: list[list[int]] = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, tx, ty, autojunk=False).get_opcodes():
        if tag == "equal":
            continue
        if i2 > i1 and x[px[i1] : px[i2]].strip():
            sx.append([px[i1], px[i2]])
        if j2 > j1 and y[py[j1] : py[j2]].strip():
            sy.append([py[j1], py[j2]])
    return sx, sy


BLOCK_TOKEN_LIMIT = 3000  # Above this size, block_spans() pairs lines instead.


def block_spans(xs: list[str], ys: list[str]) -> tuple[list[list[list[int]]], list[list[list[int]]]]:
    """Return the character ranges that differ between two blocks of lines.

    The diff runs over the words of the whole block, so text that moved to another line
    (for example a reflowed comment) stays unmarked. Whitespace and the "#" at the start
    of a comment line do not count.
    The result has one list of ranges for each line.
    """
    def words(lines: list[str]) -> list[tuple[int, int, int, str]]:
        out = []
        for li, line in enumerate(lines):
            pos = 0
            for t in SPAN_TOKEN_RE.findall(line):
                # Skip whitespace and a leading comment "#": they only show the layout.
                if not t.isspace() and not (t == "#" and not line[:pos].strip()):
                    out.append((li, pos, pos + len(t), t))
                pos += len(t)
        return out

    wx, wy = words(xs), words(ys)
    sx: list[list[list[int]]] = [[] for _ in xs]
    sy: list[list[list[int]]] = [[] for _ in ys]
    if len(wx) > BLOCK_TOKEN_LIMIT or len(wy) > BLOCK_TOKEN_LIMIT:
        return pair_spans(xs, ys)
    ops = difflib.SequenceMatcher(None, [w[3] for w in wx], [w[3] for w in wy], autojunk=False).get_opcodes()
    # One equal word between two changes is mostly chance ("the", "only", "."). Count it as changed.
    for k in range(1, len(ops) - 1):
        tag, i1, i2, j1, j2 = ops[k]
        if tag == "equal" and i2 - i1 == 1 and ops[k - 1][0] != "equal" and ops[k + 1][0] != "equal":
            ops[k] = ("replace", i1, i2, j1, j2)

    def mark(ws: list[tuple[int, int, int, str]], out: list[list[list[int]]], lines: list[str]) -> None:
        for li, a, b, _ in ws:
            spans = out[li]
            # Join with the previous range when only whitespace separates them.
            if spans and not lines[li][spans[-1][1] : a].strip():
                spans[-1][1] = b
            else:
                spans.append([a, b])

    for tag, i1, i2, j1, j2 in ops:
        if tag != "equal":
            mark(wx[i1:i2], sx, xs)
            mark(wy[j1:j2], sy, ys)
    return sx, sy


def pair_spans(xs: list[str], ys: list[str]) -> tuple[list[list[list[int]]], list[list[list[int]]]]:
    """Pair similar lines in order and compare each pair. Unpaired lines are marked in full."""
    sx: list[list[list[int]]] = [[[0, len(x)]] if x.strip() else [] for x in xs]
    sy: list[list[list[int]]] = [[[0, len(y)]] if y.strip() else [] for y in ys]
    ptr = 0
    for i, x in enumerate(xs):
        best, best_j = SIM_LINE, -1
        for jj in range(ptr, min(ptr + 8, len(ys))):
            r = difflib.SequenceMatcher(None, x, ys[jj], autojunk=False).ratio()
            if r > best:
                best, best_j = r, jj
        if best_j >= 0:
            sx[i], sy[best_j] = change_spans(x, ys[best_j])
            ptr = best_j + 1
    return sx, sy


@dataclass
class Move:
    kind: str  # "moved", "similar", or "reindent"
    sf: int  # Source file index and first line (old side).
    si: int
    df: int  # Destination file index and first line (new side).
    dj: int
    na: int  # Number of lines on the old side.
    nb: int  # Number of lines on the new side.
    p: int = -1  # First index into Analysis.rem.
    q: int = -1  # First index into Analysis.add.


class Analysis:
    def __init__(self, files: list[FileDiff]):
        self.files = files
        for f in files:
            if not f.binary:
                f.opcodes = difflib.SequenceMatcher(None, f.a, f.b, autojunk=False).get_opcodes()
        # Flat lists of removed and added lines: (file index, line index, opcode index).
        self.rem: list[tuple[int, int, int]] = []
        self.add: list[tuple[int, int, int]] = []
        for fi, f in enumerate(files):
            for k, (tag, i1, i2, j1, j2) in enumerate(f.opcodes):
                if tag in ("delete", "replace"):
                    self.rem += [(fi, i, k) for i in range(i1, i2)]
                if tag in ("insert", "replace"):
                    self.add += [(fi, j, k) for j in range(j1, j2)]
        self.rem_text = [files[fi].a[i] for fi, i, _ in self.rem]
        self.add_text = [files[fi].b[j] for fi, j, _ in self.add]
        self.rem_norm = [norm(t) for t in self.rem_text]
        self.add_norm = [norm(t) for t in self.add_text]
        self.used_r = [False] * len(self.rem)
        self.used_a = [False] * len(self.add)
        self.moves: list[Move] = []
        self.find_exact_moves()
        self.rem_tok = [TOKEN_RE.findall(t) for t in self.rem_text]
        self.add_tok = [TOKEN_RE.findall(t) for t in self.add_text]
        self.find_similar_blocks()
        self.extend_blocks()
        self.merge_fragments()
        self.fix_kinds()

    @staticmethod
    def contiguous(lst: list[tuple[int, int, int]], p: int, k: int) -> bool:
        return p + k < len(lst) and lst[p + k][0] == lst[p][0] and lst[p + k][1] == lst[p][1] + k

    def free(self, p: int, q: int, k: int) -> bool:
        return (
            self.contiguous(self.rem, p, k)
            and self.contiguous(self.add, q, k)
            and not self.used_r[p + k]
            and not self.used_a[q + k]
        )

    def record(self, kind: str, p: int, q: int, n: int) -> None:
        for k in range(n):
            self.used_r[p + k] = True
            self.used_a[q + k] = True
        self.moves.append(Move(kind, self.rem[p][0], self.rem[p][1], self.add[q][0], self.add[q][1], n, n, p, q))

    def similar_pair(self, p: int, q: int) -> bool:
        """Return True if removed line p and added line q are both blank or similar."""
        x, y = self.rem_norm[p], self.add_norm[q]
        if not x and not y:
            return True
        return bool(x and y) and token_ratio(self.rem_tok[p], self.add_tok[q]) >= SIM_LINE

    def extend_blocks(self) -> None:
        """Grow each block over neighboring lines that are similar on both sides.

        An edited line often stops a block. This step adds such lines to the block.
        """
        for m in self.moves:
            if m.kind == "reindent":
                continue
            grown = False
            # Grow down.
            while (
                self.contiguous(self.rem, m.p, m.na)
                and self.contiguous(self.add, m.q, m.nb)
                and not self.used_r[m.p + m.na]
                and not self.used_a[m.q + m.nb]
                and self.similar_pair(m.p + m.na, m.q + m.nb)
            ):
                self.used_r[m.p + m.na] = self.used_a[m.q + m.nb] = True
                m.na += 1
                m.nb += 1
                grown = True
            # Grow up.
            while (
                m.p > 0
                and m.q > 0
                and self.rem[m.p - 1][0] == m.sf
                and self.rem[m.p - 1][1] == m.si - 1
                and self.add[m.q - 1][0] == m.df
                and self.add[m.q - 1][1] == m.dj - 1
                and not self.used_r[m.p - 1]
                and not self.used_a[m.q - 1]
                and self.similar_pair(m.p - 1, m.q - 1)
            ):
                m.p -= 1
                m.q -= 1
                m.si -= 1
                m.dj -= 1
                m.na += 1
                m.nb += 1
                self.used_r[m.p] = self.used_a[m.q] = True
                grown = True
            # Do not start or end a block on blank lines.
            while m.na > 1 and m.nb > 1 and not self.rem_norm[m.p] and not self.add_norm[m.q]:
                self.used_r[m.p] = self.used_a[m.q] = False
                m.p += 1
                m.q += 1
                m.si += 1
                m.dj += 1
                m.na -= 1
                m.nb -= 1
            while m.na > 1 and m.nb > 1 and not self.rem_norm[m.p + m.na - 1] and not self.add_norm[m.q + m.nb - 1]:
                self.used_r[m.p + m.na - 1] = self.used_a[m.q + m.nb - 1] = False
                m.na -= 1
                m.nb -= 1
            if grown:
                m.kind = "similar"  # fix_kinds() resets this when the lines are equal.

    def fix_kinds(self) -> None:
        """Label a block "moved" when its two sides differ only in whitespace."""
        for m in self.moves:
            if m.kind != "similar":
                continue
            a = [norm(x) for x in self.files[m.sf].a[m.si : m.si + m.na]]
            b = [norm(y) for y in self.files[m.df].b[m.dj : m.dj + m.nb]]
            if a == b:
                m.kind = "moved"

    def merge_fragments(self, max_gap: int = 2) -> None:
        """Join neighboring blocks that move between the same places.

        Edited lines split a moved block into fragments. Two fragments merge when the
        lines between them on both sides are unmatched removed and added lines.
        """
        moves = sorted((m for m in self.moves if m.kind != "reindent"), key=lambda m: m.p)
        merged: list[Move] = []
        for m in moves:
            prev = merged[-1] if merged else None
            if prev is not None and prev.sf == m.sf and prev.df == m.df:
                ga = m.p - (prev.p + prev.na)
                gb = m.q - (prev.q + prev.nb)
                # A gap must look like an edit: replaced lines (same count on both
                # sides) or one inserted or deleted line. A larger one-sided gap means
                # that unrelated lines were removed or added between two blocks.
                edit_like = (ga == gb and ga <= max_gap) or max(ga, gb) <= 1
                if (
                    ga >= 0
                    and gb >= 0
                    and edit_like
                    and self.contiguous(self.rem, prev.p, m.p - prev.p + m.na - 1)
                    and self.contiguous(self.add, prev.q, m.q - prev.q + m.nb - 1)
                    and not any(self.used_r[prev.p + prev.na + k] for k in range(ga))
                    and not any(self.used_a[prev.q + prev.nb + k] for k in range(gb))
                ):
                    for k in range(ga):
                        self.used_r[prev.p + prev.na + k] = True
                    for k in range(gb):
                        self.used_a[prev.q + prev.nb + k] = True
                    prev.na = m.p + m.na - prev.p
                    prev.nb = m.q + m.nb - prev.q
                    if ga or gb or m.kind != "moved":
                        prev.kind = "similar"
                    continue
            merged.append(m)
        self.moves = merged + [m for m in self.moves if m.kind == "reindent"]

    def find_exact_moves(self) -> None:
        index: dict[str, list[int]] = {}
        for q, n in enumerate(self.add_norm):
            if n:
                index.setdefault(n, []).append(q)
        for p in range(len(self.rem)):
            if self.used_r[p] or not self.rem_norm[p]:
                continue
            best_n, best_q, best_score = 0, -1, 0
            for q in index.get(self.rem_norm[p], [])[:MAX_CANDIDATES]:
                if self.used_a[q]:
                    continue
                k = 0
                while self.free(p, q, k) and self.rem_norm[p + k] == self.add_norm[q + k]:
                    k += 1
                while k and not self.rem_norm[p + k - 1]:
                    k -= 1  # Do not end a block on blank lines.
                score = sum(alnum(self.rem_text[p + i]) for i in range(k))
                if score > best_score:
                    best_n, best_q, best_score = k, q, score
            if best_q < 0:
                continue
            nonblank = sum(1 for i in range(best_n) if self.rem_norm[p + i])
            if best_score < MIN_MOVE_ALNUM or (nonblank < 2 and best_score < MIN_MOVE_ALNUM_SINGLE_LINE):
                continue
            same_hunk = self.rem[p][0] == self.add[best_q][0] and self.rem[p][2] == self.add[best_q][2]
            kind = "reindent" if same_hunk else "moved"
            self.record(kind, p, best_q, best_n)

    def find_similar_blocks(self) -> None:
        # Index added lines by identifier tokens to find candidates fast.
        postings: dict[str, list[int]] = {}
        for q, toks in enumerate(self.add_tok):
            if self.used_a[q]:
                continue
            for t in set(toks):
                if len(t) >= 3 and (t[0].isalpha() or t[0] == "_"):
                    postings.setdefault(t, []).append(q)
        for p in range(len(self.rem)):
            if self.used_r[p] or not self.rem_norm[p]:
                continue
            keys = sorted(
                {t for t in self.rem_tok[p] if t in postings},
                key=lambda t: len(postings[t]),
            )[:2]
            cands = sorted({q for t in keys for q in postings[t][:MAX_CANDIDATES]})
            best_n, best_q, best_good = 0, -1, 0
            for q in cands:
                if self.used_a[q]:
                    continue
                if self.rem[p][0] == self.add[q][0] and self.rem[p][2] == self.add[q][2]:
                    continue  # An in-place edit, which the normal diff already shows.
                if token_ratio(self.rem_tok[p], self.add_tok[q]) < SIM_START:
                    continue
                k = good = bad_run = nonblank = 0
                while self.free(p, q, k):
                    x, y = self.rem_norm[p + k], self.add_norm[q + k]
                    if not x and not y:
                        bad_run = 0
                    elif x and y and token_ratio(self.rem_tok[p + k], self.add_tok[q + k]) >= SIM_LINE:
                        good += 1
                        nonblank += 1
                        bad_run = 0
                    else:
                        nonblank += 1
                        bad_run += 1
                        if bad_run > 1:
                            break
                    k += 1
                k -= bad_run
                nonblank -= bad_run
                while k and not self.rem_norm[p + k - 1]:
                    k -= 1
                if good >= MIN_SIM_LINES and good >= 0.6 * max(nonblank, 1) and good > best_good:
                    best_n, best_q, best_good = k, q, good
            if best_q >= 0:
                self.record("similar", p, best_q, best_n)


# ------------------------------------------------------------------------- output


# Row classes for blocks. Every row also has the class "r", so do not use "r" here.
KIND_CLASS = {"moved": "m", "similar": "s", "reindent": "w"}


def whitespace_change(xa: list[str], yb: list[str]) -> int:
    """Classify the whitespace differences between lines that are equal after normalization.

    Return 0 for no difference, 1 for indentation only, and 2 for other whitespace.
    """
    result = 0
    sm = difflib.SequenceMatcher(None, [norm(x) for x in xa], [norm(y) for y in yb], autojunk=False)
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag != "equal":
            continue
        for k in range(i2 - i1):
            x, y = xa[i1 + k], yb[j1 + k]
            if x == y:
                continue
            if x.strip() == y.strip():
                result = max(result, 1)
            else:
                return 2
    return result


def start_pr_lookup(cwd: str, pr: str | None) -> subprocess.Popen | None:
    """Ask the GitHub CLI for the pull request of the current branch, or for PR "pr".

    The lookup runs in the background while the analysis runs.
    """
    if not shutil.which("gh"):
        return None
    cmd = ["gh", "pr", "view", *([pr] if pr else []), "--json", "number,url"]
    try:
        return subprocess.Popen(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None


def finish_pr_lookup(proc: subprocess.Popen | None) -> dict | None:
    if proc is None:
        return None
    try:
        out, _ = proc.communicate(timeout=10)
        info = json.loads(out) if proc.returncode == 0 else None
    except (subprocess.TimeoutExpired, ValueError):
        proc.kill()
        return None
    if not info or not str(info.get("url", "")).startswith("https://"):
        return None
    return {"number": info["number"], "url": info["url"]}


# -------------------------------------------------------------------- review notes
# A review report is a Markdown file with one note per hunk. The convention:
# - A heading with the file path in backticks starts the notes of that file.
# - Each note is a section under that heading that contains a ```diff fence with the hunk.
# - "**Risk: High**", "Medium" or "Low" in a note gives its risk class.
# The fence anchors the note by content, not by the @@ line numbers, so a note still finds
# its lines after a rebase. A note marks the changed lines of its hunk on both sides.
RISK_RE = re.compile(r"\*\*Risk:\s*(High|Medium|Low)\b", re.IGNORECASE)
HUNK_RE = re.compile(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@")
MIN_ANCHOR_CHARS = 6  # Shorter lines, such as ")" or "", give no vote in the fuzzy search.


def markdown_renderer():
    """A CommonMark renderer with tables. Raw HTML in the report shows as text."""
    from markdown_it import MarkdownIt

    md = MarkdownIt("commonmark", {"html": False}).enable("table")
    default_fence = md.renderer.rules["fence"]

    def fence(tokens, idx, options, env):
        tok = tokens[idx]
        if tok.info.strip().split()[:1] != ["diff"]:
            return default_fence(tokens, idx, options, env)
        # The panes show the hunk already, so the copy in the note starts collapsed.
        rows = []
        for line in tok.content.rstrip("\n").split("\n"):
            cls = {"+": "da", "-": "dd", "@": "dh"}.get(line[:1], "")
            rows.append(f'<span class="{cls}">{html.escape(line)}</span>' if cls else html.escape(line))
        return f'<details class="hunk"><summary>Hunk in the report</summary><pre>{chr(10).join(rows)}</pre></details>\n'

    md.renderer.rules["fence"] = fence
    return md


def parse_hunks(content: str) -> list[tuple[int, int, list[tuple[str, str]]]]:
    """Split a diff fence into hunks: (old start, new start, [(op, text)]). The starts are hints."""
    hunks: list[tuple[int, int, list[tuple[str, str]]]] = []
    for line in content.split("\n"):
        m = HUNK_RE.match(line)
        if m:
            hunks.append((int(m.group(1)), int(m.group(2)), []))
            continue
        if line.startswith(("diff --git", "index ", "--- ", "+++ ", "\\")):
            continue
        if not hunks:
            hunks.append((0, 0, []))
        if line[:1] in ("+", "-", " "):
            hunks[-1][2].append((line[0], line[1:]))
        else:  # An empty context line: the generator dropped its leading space.
            hunks[-1][2].append((" ", line))
    while hunks and hunks[-1][2] and hunks[-1][2][-1] == (" ", ""):
        hunks[-1][2].pop()  # The empty last line of the fence.
    return [h for h in hunks if h[2]]


def anchor(seq: list[str], marks: list[int], target: list[str], hint: int) -> tuple[list[int], bool]:
    """Find the lines "seq" in "target", near line "hint". Return the target lines of the
    entries "marks" of "seq", and whether the match is exact."""
    if not seq or not marks:
        return [], True
    key = [s.rstrip() for s in seq]
    tgt = [t.rstrip() for t in target]
    n = len(key)
    exact = [s for s in range(len(tgt) - n + 1) if tgt[s] == key[0] and tgt[s : s + n] == key]
    if exact:
        s = min(exact, key=lambda s: abs(s - hint))
        return [s + k for k in marks], True
    # Fuzzy: each distinct long line votes for an offset. The offset with the most votes wins.
    where: dict[str, list[int]] = {}
    for i, t in enumerate(tgt):
        if len(t.strip()) >= MIN_ANCHOR_CHARS:
            where.setdefault(t, []).append(i)
    votes: dict[int, int] = {}
    for k, s in enumerate(key):
        hits = where.get(s, [])
        if 0 < len(hits) <= 8:
            for p in hits:
                votes[p - k] = votes.get(p - k, 0) + 1
    if not votes:
        return [], False
    best = max(votes.values())
    if best < 2 and len(seq) > 2:
        return [], False
    off = min((o for o, v in votes.items() if v == best), key=lambda o: abs(o - hint))
    out = []
    for k in marks:
        p = off + k
        if not (0 <= p < len(tgt) and tgt[p] == key[k]):
            # Lines added or removed since the report shift the line. Look nearby.
            near = [q for q in range(max(0, p - 12), min(len(tgt), p + 13)) if tgt[q] == key[k]]
            if not near:
                continue  # The line is not in the file: do not mark another line.
            p = min(near, key=lambda q: abs(q - p))
        out.append(p)
    return out, False


def to_ranges(lines: list[int]) -> list[list[int]]:
    out: list[list[int]] = []
    for i in sorted(set(lines)):
        if out and out[-1][1] == i:
            out[-1][1] = i + 1
        else:
            out.append([i, i + 1])
    return out


def match_file(text: str, files: list[FileDiff]) -> int:
    """The index of the changed file that a heading names in backticks, or -1."""
    best, best_score = -1, 0
    for name in re.findall(r"`([^`\n]+)`", text):
        name = name.strip().removeprefix("./")
        for k, f in enumerate(files):
            for p in (f.new_path, f.old_path):
                # Exact, then a path that ends with the name, then a name that ends with the
                # path (with --dirs, the paths are relative to the folders).
                score = 3 if p == name else 2 if p and p.endswith("/" + name) else 1 if p and name.endswith("/" + p) else 0
                if score > best_score:
                    best, best_score = k, score
    return best


def load_notes(path: str, files: list[FileDiff]) -> dict:
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    lines = text.split("\n")
    md = markdown_renderer()
    tokens = md.parse(text)
    heads = []  # (first line, level, text)
    fences = []  # (first line, content)
    for k, tok in enumerate(tokens):
        if tok.type == "heading_open" and tok.map:
            heads.append((tok.map[0], int(tok.tag[1]), tokens[k + 1].content))
        elif tok.type == "fence" and tok.map and tok.info.strip().split()[:1] == ["diff"]:
            fences.append((tok.map[0], tok.content))
    ends = []
    for k, (line, level, _t) in enumerate(heads):
        nxt = next((h[0] for h in heads[k + 1 :] if h[1] <= level), len(lines))
        ends.append(nxt)
    file_of = [match_file(t, files) for _l, _v, t in heads]
    render = lambda a, b: md.render("\n".join(lines[a:b]))  # noqa: E731

    def ancestors(line: int) -> list[int]:
        return [k for k, h in enumerate(heads) if h[0] <= line < ends[k]]

    # Group the fences by their note: the deepest heading below the file heading.
    groups: dict[tuple[int, int, int], list[str]] = {}
    for line, content in fences:
        anc = ancestors(line)
        fh_ = next((k for k in reversed(anc) if file_of[k] >= 0), -1)
        fi = file_of[fh_] if fh_ >= 0 else -1
        m = re.search(r"^\+\+\+ (?:b/)?(\S+)", content, re.MULTILINE)
        if m:  # A full diff in the fence names its own file.
            fi = match_file(f"`{m.group(1)}`", files)
        inner = [k for k in anc if fh_ < 0 or heads[k][1] > heads[fh_][1]]
        if inner and (fh_ < 0 or inner[-1] > fh_):
            start, end = heads[inner[-1]][0], ends[inner[-1]]
        else:  # No heading of its own: the note runs to the next fence or heading.
            start = line
            end = min([h[0] for h in heads if h[0] > line] + [f[0] for f in fences if f[0] > line] + [len(lines)])
        groups.setdefault((start, end, fi), []).append(content)

    notes, unmatched = [], []
    for (start, end, fi), contents in sorted(groups.items()):
        title = next((h[2] for h in heads if h[0] == start), f"Note at line {start + 1}")
        risk = RISK_RE.search("\n".join(lines[start:end]))
        a_lines: list[int] = []
        b_lines: list[int] = []
        exact = True
        if fi >= 0:
            f = files[fi]
            for content in contents:
                for old_start, new_start, ops in parse_hunks(content):
                    for side, keep, mark, target, hint, out in (
                        ("a", " -", "-", f.a, old_start - 1, a_lines),
                        ("b", " +", "+", f.b, new_start - 1, b_lines),
                    ):
                        seq = [t for op, t in ops if op in keep]
                        marks = [k for k, (op, _t) in enumerate((o for o in ops if o[0] in keep)) if op == mark]
                        if not marks and side == "b" and not any(op == "-" for op, _t in ops):
                            marks = list(range(len(seq)))  # Context only: mark all of it.
                        got, ok = anchor(seq, marks, target, hint)
                        out.extend(got)
                        exact = exact and ok and len(got) == len(marks)
        note = {
            "title": title,
            "risk": risk.group(1).capitalize() if risk else None,
            "html": render(start, end),
            "file": fi,
            "a": to_ranges(a_lines),
            "b": to_ranges(b_lines),
            "exact": exact,
        }
        if fi < 0 or not (a_lines or b_lines):
            unmatched.append(title)
            note["file"] = -1
        notes.append(note)

    first_file = min((h[0] for k, h in enumerate(heads) if file_of[k] >= 0), default=len(lines))
    intros = {}
    for k, (line, _level, _t) in enumerate(heads):
        fi = file_of[k]
        if fi < 0 or str(fi) in intros:
            continue
        stop = min([h[0] for h in heads if h[0] > line] + [f[0] for f in fences if f[0] > line] + [ends[k]])
        intros[str(fi)] = render(line, stop)
    return {
        "name": os.path.basename(path),
        "overview": render(0, first_file),
        "intros": intros,
        "notes": notes,
        "unmatched": unmatched,
    }


def build_payload(an: Analysis, title: str) -> dict:
    files = an.files
    move_a = [[-1] * len(f.a) for f in files]
    move_b = [[-1] * len(f.b) for f in files]
    for mid, m in enumerate(an.moves):
        for k in range(m.na):
            move_a[m.sf][m.si + k] = mid
        for k in range(m.nb):
            move_b[m.df][m.dj + k] = mid
    out_files = []
    for fi, f in enumerate(files):
        ca = ["e"] * len(f.a)
        cb = ["e"] * len(f.b)
        sa: dict[int, list] = {}
        sb: dict[int, list] = {}
        ops = []
        for tag, i1, i2, j1, j2 in f.opcodes:
            t = {"equal": "e", "delete": "d", "insert": "a", "replace": "c"}[tag]
            ops.append([t, i1, i2, j1, j2])
            for i in range(i1, i2):
                ca[i] = "e" if t == "e" else ("d" if t == "d" else "c")
            for j in range(j1, j2):
                cb[j] = "e" if t == "e" else ("a" if t == "a" else "c")
            if tag == "replace":
                # Mark the removed and added words. Moved lines get their own marks.
                olds = [i for i in range(i1, i2) if move_a[fi][i] < 0]
                news = [j for j in range(j1, j2) if move_b[fi][j] < 0]
                if olds and news:
                    xs, ys = block_spans([f.a[i] for i in olds], [f.b[j] for j in news])
                    sa.update({i: x for i, x in zip(olds, xs) if x})
                    sb.update({j: y for j, y in zip(news, ys) if y})
        for i, mid in enumerate(move_a[fi]):
            if mid >= 0:
                ca[i] = KIND_CLASS[an.moves[mid].kind]
        for j, mid in enumerate(move_b[fi]):
            if mid >= 0:
                cb[j] = KIND_CLASS[an.moves[mid].kind]
        out_files.append(
            {
                "status": f.status,
                "old": f.old_path,
                "new": f.new_path,
                "binary": f.binary,
                "disk": f.disk,
                # GitHub names the diff of a file "diff-" + SHA-256 of its path.
                "gh": hashlib.sha256((f.new_path or f.old_path or "").encode()).hexdigest(),
                "a": f.a,
                "b": f.b,
                "ca": "".join(ca),
                "cb": "".join(cb),
                "sa": sa,
                "sb": sb,
                "ha": syntax_for(f.old_path, f.a),
                "hb": syntax_for(f.new_path, f.b),
                "ops": ops,
                "ma": [],
                "mb": [],
            }
        )
    for of in out_files:
        of["ca"], of["cb"] = list(of["ca"]), list(of["cb"])
    changed_counts = []
    ws_changes = []
    for mid, m in enumerate(an.moves):
        changed = 0
        ws_changes.append(
            whitespace_change(files[m.sf].a[m.si : m.si + m.na], files[m.df].b[m.dj : m.dj + m.nb])
        )
        if m.kind == "similar":
            # Align the two sides of the block and highlight the edits inside it.
            # Only the changed lines keep the "s" class. The other lines are plain moved lines.
            xa = files[m.sf].a[m.si : m.si + m.na]
            yb = files[m.df].b[m.dj : m.dj + m.nb]
            ca, cb = out_files[m.sf]["ca"], out_files[m.df]["cb"]
            for k in range(m.na):
                ca[m.si + k] = KIND_CLASS["moved"]
            for k in range(m.nb):
                cb[m.dj + k] = KIND_CLASS["moved"]
            sm = difflib.SequenceMatcher(None, [norm(x) for x in xa], [norm(y) for y in yb], autojunk=False)
            for tag, i1, i2, j1, j2 in sm.get_opcodes():
                if tag == "equal":
                    continue
                changed += max(i2 - i1, j2 - j1)
                for i in range(i1, i2):
                    ca[m.si + i] = KIND_CLASS["similar"]
                for j in range(j1, j2):
                    cb[m.dj + j] = KIND_CLASS["similar"]
                if tag != "replace":
                    continue
                xs, ys = block_spans(xa[i1:i2], yb[j1:j2])
                for k, x in enumerate(xs):
                    if x:
                        out_files[m.sf]["sa"][m.si + i1 + k] = x
                for k, y in enumerate(ys):
                    if y:
                        out_files[m.df]["sb"][m.dj + j1 + k] = y
        changed_counts.append(changed)
        out_files[m.sf]["ma"].append([m.si, m.na, mid])
        out_files[m.df]["mb"].append([m.dj, m.nb, mid])
    for of in out_files:
        of["ca"], of["cb"] = "".join(of["ca"]), "".join(of["cb"])
    moves = [
        [m.kind, m.sf, m.si, m.df, m.dj, m.na, m.nb, c, w]
        for m, c, w in zip(an.moves, changed_counts, ws_changes)
    ]
    return {"title": title, "files": out_files, "moves": moves}


