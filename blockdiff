  });
  G.innerHTML = s;
  updateThumb();
}

for (const pane of [L, R]) {
  for (const ev of ["wheel", "mousedown", "touchstart", "keydown"]) {
    pane.addEventListener(ev, () => { master = pane; }, {passive: true});
  }
  pane.addEventListener("scroll", () => { if (pane === master) sync(pane); else requestDraw(); }, {passive: true});
  pane.addEventListener("click", e => {
    const fold = e.target.closest(".r.fold");
    if (fold) return openFold(fold, pane);
    const row = e.target.closest(".r[data-m]");
    if (row) goToCounterpart(+row.dataset.m, pane === L ? "a" : "b");
  });
}
window.addEventListener("resize", requestDraw);

// ---------------------------------------------------------------- folding
function openFold(rowEl, pane) {
  const fo = LY.folds[rowEl.dataset.fold];
  const y = rowEl.offsetTop - pane.scrollTop;
  expanded.add(fo.key);
  render();
  pane.scrollTop = (pane === L ? LY.ya[fo.ia] : LY.yb[fo.ib]) * LH - y;
  master = pane;
  sync(pane);
}

// The old-side line at the middle of the left pane, to keep it in place.
function centerLine() {
  if (!LY || !LY.rowsA.length) return 0;
  const r = Math.max(0, Math.min(LY.rowsA.length - 1, Math.floor((L.scrollTop + L.clientHeight / 2) / LH)));
  const e = LY.rowsA[r];
  return typeof e === "number" ? e : e.ia;
}

function setFolding(on) {
  folding = on;
  try { localStorage.setItem("blockdiff.fold", on ? "1" : "0"); } catch (e) { /* storage unavailable */ }
  FOLDBTN.setAttribute("aria-pressed", String(on));
  FOLDBTN.textContent = (on ? "Show identical lines" : "Hide identical lines") + " (h)";
  if (cur < 0) return;
  const line = centerLine();
  expanded.clear();
  render();
  scrollPaneTo(L, LY.ya[line], 0.5);
  master = L;
  sync(L);
}
FOLDBTN.addEventListener("click", () => setFolding(!folding));

// ---------------------------------------------------------------- navigation
function flash(pane, line, n) {
  for (let k = 0; k < n; k++) pane.querySelector(`.r[data-i="${line + k}"]`)?.classList.add("flash");
  setTimeout(() => pane.querySelectorAll(".flash").forEach(r => r.classList.remove("flash")), 1200);
}

function goToCounterpart(mid, side) {
  const [kind, sf, si, df, dj, na, nb] = D.moves[mid];
  const tf = side === "a" ? df : sf, tl = side === "a" ? dj : si, n = side === "a" ? nb : na;
  const target = side === "a" ? R : L;
  if (tf !== cur) {
    showFile(tf, false);
    scrollPaneTo(target, (side === "a" ? LY.yb : LY.ya)[tl], 1 / 3);
    master = target;
    sync(target);
  } else {
    const src = side === "a" ? L : R;
    const srcRow = side === "a" ? LY.ya[si] : LY.yb[dj];
    const y = srcRow * LH - src.scrollTop;
    target.scrollTop = (side === "a" ? LY.yb[dj] : LY.ya[si]) * LH - y;
    requestDraw();
  }
  flash(target, tl, n);
}

function jumpChange(dir) {
  const c = (L.scrollTop + L.clientHeight / 3) / LH;
  const ch = LY.dops.filter(o => o[0] !== "e" && o[0] !== "f");
  const op = dir > 0 ? ch.find(o => o[1] > c + 0.5) : ch.slice().reverse().find(o => o[1] < c - 0.5);
  if (op) { scrollPaneTo(L, op[1], 1 / 3); master = L; sync(L); }
  else if (dir > 0 && cur < D.files.length - 1) showFile(cur + 1);
  else if (dir < 0 && cur > 0) showFile(cur - 1);
}

function nextFile(dir) {
  const i = cur + dir;
  if (i >= 0 && i < D.files.length) showFile(i);
}

// Keyboard shortcuts. Several common conventions are supported:
//   Meld / WinMerge / Araxis: Alt+Down, Alt+Up      VS Code: F7, Shift+F7
const KEYS = [
  [e => e.altKey && !e.shiftKey && e.key === "ArrowDown", () => jumpChange(1)],
  [e => e.altKey && !e.shiftKey && e.key === "ArrowUp", () => jumpChange(-1)],
  [e => e.altKey && e.shiftKey && e.key === "ArrowDown", () => nextFile(1)],
  [e => e.altKey && e.shiftKey && e.key === "ArrowUp", () => nextFile(-1)],
  [e => !e.altKey && !e.shiftKey && e.key === "F7", () => jumpChange(1)],
  [e => !e.altKey && e.shiftKey && e.key === "F7", () => jumpChange(-1)],
  [e => !e.altKey && e.key === "n", () => jumpChange(1)],
  [e => !e.altKey && e.key === "p", () => jumpChange(-1)],
  [e => !e.altKey && e.key === "j", () => nextFile(1)],
  [e => !e.altKey && e.key === "k", () => nextFile(-1)],
  [e => !e.altKey && e.key === "h", () => setFolding(!folding)],
];

document.addEventListener("keydown", e => {
  if (e.ctrlKey || e.metaKey) return;
  const hit = KEYS.find(([match]) => match(e));
  if (hit) { e.preventDefault(); hit[1](); }
});

// ---------------------------------------------------------------- start
(function init() {
  const list = document.getElementById("files");
  let adds = 0, dels = 0;
  D.files.forEach((f, i) => {
    const counts = {a: 0, d: 0, m: 0};
    for (const c of f.cb) if (c !== "e") counts.a++;
    for (const c of f.ca) if (c !== "e") counts.d++;
    counts.m = f.ma.length + f.mb.length;
    adds += counts.a; dels += counts.d;
    const p = pathOf(f), dir = p.includes("/") ? p.slice(0, p.lastIndexOf("/")) : "";
    const el = document.createElement("div");
    el.className = "fi";
    el.innerHTML = `<div><span class="st ${f.status}">${f.status}</span><span class="nm">${esc(base(p))}</span></div>` +
      `<div class="dir">${esc(dir)}</div>` +
      `<div class="cnt"><span class="p">+${counts.a}</span> <span class="m">−${counts.d}</span>` +
      (counts.m ? ` · ${counts.m} moved/similar block ends` : "") + `</div>`;
    el.addEventListener("click", () => showFile(i));
    list.appendChild(el);
  });
  const kinds = {moved: 0, similar: 0, reindent: 0};
  for (const m of D.moves) kinds[m[0]]++;
  document.getElementById("summary").textContent =
    `${D.title} · ${D.files.length} files · +${adds} −${dels} · ` +
    `${kinds.moved} moved, ${kinds.similar} similar, ${kinds.reindent} re-indented blocks`;
  // Optional deep link: #f=<file index or path suffix>&l=<line on the left side>&fold=1
  const h = new URLSearchParams(location.hash.slice(1));
  if (h.has("fold")) folding = h.get("fold") === "1";
  FOLDBTN.setAttribute("aria-pressed", String(folding));
  FOLDBTN.textContent = (folding ? "Show identical lines" : "Hide identical lines") + " (h)";
  let fi = 0;
  if (h.has("f")) {
    const q = h.get("f");
    fi = /^\d+$/.test(q) ? +q : Math.max(0, D.files.findIndex(f => pathOf(f).endsWith(q)));
  }
  if (D.files.length) {
    showFile(Math.min(fi, D.files.length - 1), !h.has("l"));
    if (h.has("l")) {
      const line = Math.max(0, Math.min(+h.get("l") - 1, D.files[cur].a.length));
      scrollPaneTo(L, LY.ya[line], 1 / 3);
      master = L;
      sync(L);
    }
  }
})();
</script>
</body>
</html>
"""


def write_html(payload: dict, out: str) -> None:
    data = json.dumps(payload, separators=(",", ":")).replace("</", "<\\/")
    with open(out, "w", encoding="utf-8") as fh:
        fh.write(HTML.replace("__DATA__", data))


def open_browser(path: str) -> str:
    """Open the page in Firefox if it is installed, otherwise in the default browser."""
    url = "file://" + os.path.abspath(path)
    firefox = shutil.which("firefox")
    if firefox:
        try:
            # Start a separate process so that blockdiff does not wait for the browser.
            subprocess.Popen(
                [firefox, url],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            return "Firefox"
        except OSError:
            pass
    webbrowser.open(url)
    return "the default browser"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("revs", nargs="*", help="zero, one, or two revisions, or A..B / A...B")
    ap.add_argument("-C", dest="repo", default=".", help="repository path (default: current directory)")
    ap.add_argument("--dirs", nargs=2, metavar=("LEFT", "RIGHT"), help="compare two folders")
    ap.add_argument("-o", "--output", help="HTML output file (default: /tmp/blockdiff-<uid>/blockdiff.html)")
    ap.add_argument("--no-open", action="store_true", help="do not open the browser")
    ap.add_argument("--paths", nargs="*", default=[], help="limit the diff to these paths")
    args = ap.parse_args()

    if args.dirs:
        files = from_dirs(*args.dirs)
        title = f"{args.dirs[0]} → {args.dirs[1]}"
    else:
        revs = args.revs
        if len(revs) == 1 and "..." in revs[0]:
            a, b = revs[0].split("...", 1)
            old = run_git(args.repo, "merge-base", a or "HEAD", b or "HEAD").decode().strip()
            new: str | None = b or "HEAD"
            title = revs[0]
        elif len(revs) == 1 and ".." in revs[0]:
            a, b = revs[0].split("..", 1)
            old, new = a or "HEAD", b or "HEAD"
            title = revs[0]
        elif len(revs) == 2:
            old, new = revs
            title = f"{old} → {new}"
        elif len(revs) == 1:
            old, new = revs[0], None
            title = f"{old} → working tree"
        elif not revs:
            old, new = "HEAD", None
            title = "HEAD → working tree"
        else:
            ap.error("give at most two revisions")
        files = from_git(args.repo, old, new, args.paths)

    files.sort(key=lambda f: f.new_path or f.old_path or "")
    if not files:
        print("blockdiff: no differences", file=sys.stderr)
        return 0
    payload = build_payload(Analysis(files), title)
    out = args.output
    if not out:
        # Use a fixed file per user. Firefox gives each local file its own localStorage,
        # so a fixed path lets the page remember settings such as "hide identical lines".
        folder = os.path.join(tempfile.gettempdir(), f"blockdiff-{os.getuid()}")
        os.makedirs(folder, mode=0o700, exist_ok=True)
        out = os.path.join(folder, "blockdiff.html")
    write_html(payload, out)
    kinds = [m[0] for m in payload["moves"]]
    print(
        f"blockdiff: {len(files)} files, {kinds.count('moved')} moved, "
        f"{kinds.count('similar')} similar, {kinds.count('reindent')} re-indented blocks -> {out}"
    )
    if not args.no_open:
        print(f"blockdiff: opened in {open_browser(out)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
