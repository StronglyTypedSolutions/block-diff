  const max = from.scrollHeight - from.clientHeight;
  const frac = max > 0 ? Math.min(Math.max(from.scrollTop / max, 0), 1) : 0;
  const anchor = (from.scrollTop + from.clientHeight * frac) / LH;
  other.scrollTop = mapRow(anchor, from === L) * LH - other.clientHeight * frac;
  other.scrollLeft = from.scrollLeft;
  requestDraw();
}

function scrollPaneTo(pane, row, frac) {
  pane.scrollTop = row * LH - pane.clientHeight * frac;
}

function requestDraw() {
  if (drawPending) return;
  drawPending = true;
  requestAnimationFrame(() => { drawPending = false; draw(); });
}

function band(a1, a2, b1, b2, W) {
  const m = W / 2;
