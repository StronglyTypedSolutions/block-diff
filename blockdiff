#!/usr/bin/env python3
"""blockdiff: side-by-side diff with moved-block and similar-block detection.

The tool writes one self-contained HTML file (inline SVG connectors and JavaScript
for synchronized scrolling) and opens it in the default browser.

Usage:
    blockdiff                      # HEAD against the working tree
    blockdiff HEAD~1               # HEAD~1 against the working tree
    blockdiff HEAD~1 HEAD          # two revisions
    blockdiff main...HEAD          # merge base of main and HEAD against HEAD
    blockdiff --dirs LEFT RIGHT    # two folders (for "git difftool -d")
"""

from __future__ import annotations

import argparse
import builtins
import difflib
import io
import keyword
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import tokenize
import webbrowser
from dataclasses import dataclass, field

# Detection thresholds.
MIN_MOVE_ALNUM = 20  # Same minimum as "git diff --color-moved".
MIN_MOVE_ALNUM_SINGLE_LINE = 50  # A one-line move must be longer to count.
SIM_START = 0.6  # Token similarity that starts a similar block.
SIM_LINE = 0.5  # Token similarity that continues a similar block.
MIN_SIM_LINES = 3  # Minimum number of similar non-blank lines in a similar block.
MAX_CANDIDATES = 64

TOKEN_RE = re.compile(r"[A-Za-z_]\w*|\d+|\S")
SPAN_TOKEN_RE = re.compile(r"\w+|\s+|[^\w\s]")


@dataclass
class FileDiff:
    status: str
    old_path: str | None
    new_path: str | None
    a: list[str]
    b: list[str]
    binary: bool = False
    opcodes: list[tuple[str, int, int, int, int]] = field(default_factory=list)


# --------------------------------------------------------------------------- input


def run_git(repo: str, *args: str) -> bytes:
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, check=True).stdout


def to_lines(data: bytes | None) -> tuple[list[str], bool]:
    if data is None:
        return [], False
    if b"\0" in data[:8192]:
        return [], True
    return data.decode("utf-8", "replace").expandtabs(4).splitlines(), False


def git_show(repo: str, rev: str, path: str) -> bytes | None:
    try:
        return run_git(repo, "show", f"{rev}:{path}")
    except subprocess.CalledProcessError:
        return None


def from_git(repo: str, old: str, new: str | None, paths: list[str]) -> list[FileDiff]:
    top = run_git(repo, "rev-parse", "--show-toplevel").decode().strip()
    cmd = ["diff", "--name-status", "-z", "-M", old] + ([new] if new else []) + ["--", *paths]
    parts = run_git(top, *cmd).decode().split("\0")
    files = []
    i = 0
    while i < len(parts) - 1:
        status = parts[i][0]
        i += 1
        if status in "RC":
            old_path, new_path = parts[i], parts[i + 1]
            i += 2
        else:
            old_path = new_path = parts[i]
            i += 1
        old_data = None if status == "A" else git_show(top, old, old_path)
        if status == "D":
            new_data = None
        elif new is None:
            with open(os.path.join(top, new_path), "rb") as fh:
                new_data = fh.read()
        else:
            new_data = git_show(top, new, new_path)
        a, bin_a = to_lines(old_data)
        b, bin_b = to_lines(new_data)
        files.append(
            FileDiff(
                status,
                None if status == "A" else old_path,
                None if status == "D" else new_path,
                a,
                b,
                bin_a or bin_b,
            )
        )
    return files


def from_dirs(left: str, right: str) -> list[FileDiff]:
    def walk(root: str) -> set[str]:
        out = set()
        for base, _dirs, names in os.walk(root, followlinks=True):
            for name in names:
                out.add(os.path.relpath(os.path.join(base, name), root))
        return out

    def read(root: str, rel: str) -> bytes | None:
        path = os.path.join(root, rel)
        if not os.path.isfile(path):
            return None
        with open(path, "rb") as fh:
            return fh.read()

    files = []
    for rel in sorted(walk(left) | walk(right)):
        old_data, new_data = read(left, rel), read(right, rel)
        if old_data == new_data:
            continue
        status = "A" if old_data is None else "D" if new_data is None else "M"
        a, bin_a = to_lines(old_data)
        b, bin_b = to_lines(new_data)
        files.append(
            FileDiff(
                status,
                None if status == "A" else rel,
                None if status == "D" else rel,
                a,
                b,
                bin_a or bin_b,
            )
        )
    return files


# ----------------------------------------------------------------------- analysis


def norm(line: str) -> str:
    return " ".join(line.split())


def alnum(line: str) -> int:
    return sum(c.isalnum() for c in line)


def token_ratio(x: list[str], y: list[str]) -> float:
    sm = difflib.SequenceMatcher(None, x, y, autojunk=False)
    if sm.real_quick_ratio() < SIM_LINE or sm.quick_ratio() < SIM_LINE:
        return 0.0
    return sm.ratio()


# --------------------------------------------------------------- syntax colors

PY_BUILTINS = set(dir(builtins)) | {"self", "cls"}
PY_STRING_TOKENS = {tokenize.STRING} | {
    getattr(tokenize, n) for n in ("FSTRING_START", "FSTRING_MIDDLE", "FSTRING_END") if hasattr(tokenize, n)
}


def python_syntax(lines: list[str]) -> dict[int, list[list]]:
    """Return syntax ranges per line: {line: [[start, end, class], ...]}.

    Classes: "k" keyword, "s" string, "c" comment, "n" number, "b" builtin,
    "f" function or class name, "d" decorator. When the code does not tokenize,
    the function returns the ranges found up to the error.
    """
    out: dict[int, list[list]] = {}

    def add(start: tuple[int, int], end: tuple[int, int], cls: str) -> None:
        (r1, c1), (r2, c2) = start, end
        for r in range(r1, r2 + 1):
            if r - 1 >= len(lines):
                break
            s = c1 if r == r1 else 0
            e = c2 if r == r2 else len(lines[r - 1])
            if e > s:
                out.setdefault(r - 1, []).append([s, e, cls])

    source = "\n".join(lines) + "\n"
    prev = None  # Previous significant token.
    try:
        for tok in tokenize.generate_tokens(io.StringIO(source).readline):
            typ, text = tok.type, tok.string
            if typ == tokenize.COMMENT:
                add(tok.start, tok.end, "c")
            elif typ in PY_STRING_TOKENS:
                add(tok.start, tok.end, "s")
            elif typ == tokenize.NUMBER:
                add(tok.start, tok.end, "n")
            elif typ == tokenize.NAME:
                if prev is not None and prev.type == tokenize.NAME and prev.string in ("def", "class"):
                    add(tok.start, tok.end, "f")
                elif prev is not None and prev.type == tokenize.OP and prev.string == "@":
                    add(tok.start, tok.end, "d")
                elif keyword.iskeyword(text):
                    add(tok.start, tok.end, "k")
                elif text in PY_BUILTINS and not (prev is not None and prev.string == "."):
                    add(tok.start, tok.end, "b")
            elif typ == tokenize.OP and text == "@" and (prev is None or prev.type in (tokenize.NEWLINE, tokenize.NL, tokenize.INDENT, tokenize.DEDENT)):
                add(tok.start, tok.end, "d")
            if typ not in (tokenize.NL, tokenize.COMMENT):
                prev = tok
    except (tokenize.TokenError, SyntaxError):
        pass
    return out


def syntax_for(path: str | None, lines: list[str]) -> dict[int, list[list]]:
    if path and path.endswith((".py", ".pyi")):
        return python_syntax(lines)
    return {}


def change_spans(x: str, y: str) -> tuple[list[list[int]], list[list[int]]]:
    """Return the character ranges that differ between two paired lines."""
    tx, ty = SPAN_TOKEN_RE.findall(x), SPAN_TOKEN_RE.findall(y)
    px = [0]
    for t in tx:
        px.append(px[-1] + len(t))
    py = [0]
    for t in ty:
        py.append(py[-1] + len(t))
    sx: list[list[int]] = []
    sy: list[list[int]] = []
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, tx, ty, autojunk=False).get_opcodes():
        if tag == "equal":
            continue
        if i2 > i1 and x[px[i1] : px[i2]].strip():
            sx.append([px[i1], px[i2]])
        if j2 > j1 and y[py[j1] : py[j2]].strip():
            sy.append([py[j1], py[j2]])
    return sx, sy


@dataclass
class Move:
    kind: str  # "moved", "similar", or "reindent"
    sf: int  # Source file index and first line (old side).
    si: int
    df: int  # Destination file index and first line (new side).
    dj: int
    na: int  # Number of lines on the old side.
    nb: int  # Number of lines on the new side.
    p: int = -1  # First index into Analysis.rem.
    q: int = -1  # First index into Analysis.add.


class Analysis:
    def __init__(self, files: list[FileDiff]):
        self.files = files
        for f in files:
            if not f.binary:
                f.opcodes = difflib.SequenceMatcher(None, f.a, f.b, autojunk=False).get_opcodes()
        # Flat lists of removed and added lines: (file index, line index, opcode index).
        self.rem: list[tuple[int, int, int]] = []
        self.add: list[tuple[int, int, int]] = []
        for fi, f in enumerate(files):
            for k, (tag, i1, i2, j1, j2) in enumerate(f.opcodes):
                if tag in ("delete", "replace"):
                    self.rem += [(fi, i, k) for i in range(i1, i2)]
                if tag in ("insert", "replace"):
                    self.add += [(fi, j, k) for j in range(j1, j2)]
        self.rem_text = [files[fi].a[i] for fi, i, _ in self.rem]
        self.add_text = [files[fi].b[j] for fi, j, _ in self.add]
        self.rem_norm = [norm(t) for t in self.rem_text]
        self.add_norm = [norm(t) for t in self.add_text]
        self.used_r = [False] * len(self.rem)
        self.used_a = [False] * len(self.add)
        self.moves: list[Move] = []
        self.find_exact_moves()
        self.rem_tok = [TOKEN_RE.findall(t) for t in self.rem_text]
        self.add_tok = [TOKEN_RE.findall(t) for t in self.add_text]
        self.find_similar_blocks()
        self.extend_blocks()
        self.merge_fragments()
        self.fix_kinds()

    @staticmethod
    def contiguous(lst: list[tuple[int, int, int]], p: int, k: int) -> bool:
        return p + k < len(lst) and lst[p + k][0] == lst[p][0] and lst[p + k][1] == lst[p][1] + k

    def free(self, p: int, q: int, k: int) -> bool:
        return (
            self.contiguous(self.rem, p, k)
            and self.contiguous(self.add, q, k)
            and not self.used_r[p + k]
            and not self.used_a[q + k]
        )

    def record(self, kind: str, p: int, q: int, n: int) -> None:
        for k in range(n):
            self.used_r[p + k] = True
            self.used_a[q + k] = True
        self.moves.append(Move(kind, self.rem[p][0], self.rem[p][1], self.add[q][0], self.add[q][1], n, n, p, q))

    def similar_pair(self, p: int, q: int) -> bool:
        """Return True if removed line p and added line q are both blank or similar."""
        x, y = self.rem_norm[p], self.add_norm[q]
        if not x and not y:
            return True
        return bool(x and y) and token_ratio(self.rem_tok[p], self.add_tok[q]) >= SIM_LINE

    def extend_blocks(self) -> None:
        """Grow each block over neighboring lines that are similar on both sides.

        An edited line often stops a block. This step adds such lines to the block.
        """
        for m in self.moves:
            if m.kind == "reindent":
                continue
            grown = False
            # Grow down.
            while (
                self.contiguous(self.rem, m.p, m.na)
                and self.contiguous(self.add, m.q, m.nb)
                and not self.used_r[m.p + m.na]
                and not self.used_a[m.q + m.nb]
                and self.similar_pair(m.p + m.na, m.q + m.nb)
            ):
                self.used_r[m.p + m.na] = self.used_a[m.q + m.nb] = True
                m.na += 1
                m.nb += 1
                grown = True
            # Grow up.
            while (
                m.p > 0
                and m.q > 0
                and self.rem[m.p - 1][0] == m.sf
                and self.rem[m.p - 1][1] == m.si - 1
                and self.add[m.q - 1][0] == m.df
                and self.add[m.q - 1][1] == m.dj - 1
                and not self.used_r[m.p - 1]
                and not self.used_a[m.q - 1]
                and self.similar_pair(m.p - 1, m.q - 1)
            ):
                m.p -= 1
                m.q -= 1
                m.si -= 1
                m.dj -= 1
                m.na += 1
                m.nb += 1
                self.used_r[m.p] = self.used_a[m.q] = True
                grown = True
            # Do not start or end a block on blank lines.
            while m.na > 1 and m.nb > 1 and not self.rem_norm[m.p] and not self.add_norm[m.q]:
                self.used_r[m.p] = self.used_a[m.q] = False
                m.p += 1
                m.q += 1
                m.si += 1
                m.dj += 1
                m.na -= 1
                m.nb -= 1
            while m.na > 1 and m.nb > 1 and not self.rem_norm[m.p + m.na - 1] and not self.add_norm[m.q + m.nb - 1]:
                self.used_r[m.p + m.na - 1] = self.used_a[m.q + m.nb - 1] = False
                m.na -= 1
                m.nb -= 1
            if grown:
                m.kind = "similar"  # fix_kinds() resets this when the lines are equal.

    def fix_kinds(self) -> None:
        """Label a block "moved" when its two sides differ only in whitespace."""
        for m in self.moves:
            if m.kind != "similar":
                continue
            a = [norm(x) for x in self.files[m.sf].a[m.si : m.si + m.na]]
            b = [norm(y) for y in self.files[m.df].b[m.dj : m.dj + m.nb]]
            if a == b:
                m.kind = "moved"

    def merge_fragments(self, max_gap: int = 2) -> None:
        """Join neighboring blocks that move between the same places.

        Edited lines split a moved block into fragments. Two fragments merge when the
        lines between them on both sides are unmatched removed and added lines.
        """
        moves = sorted((m for m in self.moves if m.kind != "reindent"), key=lambda m: m.p)
        merged: list[Move] = []
        for m in moves:
            prev = merged[-1] if merged else None
            if prev is not None and prev.sf == m.sf and prev.df == m.df:
                ga = m.p - (prev.p + prev.na)
                gb = m.q - (prev.q + prev.nb)
                # A gap must look like an edit: replaced lines (same count on both
                # sides) or one inserted or deleted line. A larger one-sided gap means
                # that unrelated lines were removed or added between two blocks.
                edit_like = (ga == gb and ga <= max_gap) or max(ga, gb) <= 1
                if (
                    ga >= 0
                    and gb >= 0
                    and edit_like
                    and self.contiguous(self.rem, prev.p, m.p - prev.p + m.na - 1)
                    and self.contiguous(self.add, prev.q, m.q - prev.q + m.nb - 1)
                    and not any(self.used_r[prev.p + prev.na + k] for k in range(ga))
                    and not any(self.used_a[prev.q + prev.nb + k] for k in range(gb))
                ):
                    for k in range(ga):
                        self.used_r[prev.p + prev.na + k] = True
                    for k in range(gb):
                        self.used_a[prev.q + prev.nb + k] = True
                    prev.na = m.p + m.na - prev.p
                    prev.nb = m.q + m.nb - prev.q
                    if ga or gb or m.kind != "moved":
                        prev.kind = "similar"
                    continue
            merged.append(m)
        self.moves = merged + [m for m in self.moves if m.kind == "reindent"]

    def find_exact_moves(self) -> None:
        index: dict[str, list[int]] = {}
        for q, n in enumerate(self.add_norm):
            if n:
                index.setdefault(n, []).append(q)
        for p in range(len(self.rem)):
            if self.used_r[p] or not self.rem_norm[p]:
                continue
            best_n, best_q, best_score = 0, -1, 0
            for q in index.get(self.rem_norm[p], [])[:MAX_CANDIDATES]:
                if self.used_a[q]:
                    continue
                k = 0
                while self.free(p, q, k) and self.rem_norm[p + k] == self.add_norm[q + k]:
                    k += 1
                while k and not self.rem_norm[p + k - 1]:
                    k -= 1  # Do not end a block on blank lines.
                score = sum(alnum(self.rem_text[p + i]) for i in range(k))
                if score > best_score:
                    best_n, best_q, best_score = k, q, score
            if best_q < 0:
                continue
            nonblank = sum(1 for i in range(best_n) if self.rem_norm[p + i])
            if best_score < MIN_MOVE_ALNUM or (nonblank < 2 and best_score < MIN_MOVE_ALNUM_SINGLE_LINE):
                continue
            same_hunk = self.rem[p][0] == self.add[best_q][0] and self.rem[p][2] == self.add[best_q][2]
            kind = "reindent" if same_hunk else "moved"
            self.record(kind, p, best_q, best_n)

    def find_similar_blocks(self) -> None:
        # Index added lines by identifier tokens to find candidates fast.
        postings: dict[str, list[int]] = {}
        for q, toks in enumerate(self.add_tok):
            if self.used_a[q]:
                continue
            for t in set(toks):
                if len(t) >= 3 and (t[0].isalpha() or t[0] == "_"):
                    postings.setdefault(t, []).append(q)
        for p in range(len(self.rem)):
            if self.used_r[p] or not self.rem_norm[p]:
                continue
            keys = sorted(
                {t for t in self.rem_tok[p] if t in postings},
                key=lambda t: len(postings[t]),
            )[:2]
            cands = sorted({q for t in keys for q in postings[t][:MAX_CANDIDATES]})
            best_n, best_q, best_good = 0, -1, 0
            for q in cands:
                if self.used_a[q]:
                    continue
                if self.rem[p][0] == self.add[q][0] and self.rem[p][2] == self.add[q][2]:
                    continue  # An in-place edit, which the normal diff already shows.
                if token_ratio(self.rem_tok[p], self.add_tok[q]) < SIM_START:
                    continue
                k = good = bad_run = nonblank = 0
                while self.free(p, q, k):
                    x, y = self.rem_norm[p + k], self.add_norm[q + k]
                    if not x and not y:
                        bad_run = 0
                    elif x and y and token_ratio(self.rem_tok[p + k], self.add_tok[q + k]) >= SIM_LINE:
                        good += 1
                        nonblank += 1
                        bad_run = 0
                    else:
                        nonblank += 1
                        bad_run += 1
                        if bad_run > 1:
                            break
                    k += 1
                k -= bad_run
                nonblank -= bad_run
                while k and not self.rem_norm[p + k - 1]:
                    k -= 1
                if good >= MIN_SIM_LINES and good >= 0.6 * max(nonblank, 1) and good > best_good:
                    best_n, best_q, best_good = k, q, good
            if best_q >= 0:
                self.record("similar", p, best_q, best_n)


# ------------------------------------------------------------------------- output


# Row classes for blocks. Every row also has the class "r", so do not use "r" here.
KIND_CLASS = {"moved": "m", "similar": "s", "reindent": "w"}


def whitespace_change(xa: list[str], yb: list[str]) -> int:
    """Classify the whitespace differences between lines that are equal after normalization.

    Return 0 for no difference, 1 for indentation only, and 2 for other whitespace.
    """
    result = 0
    sm = difflib.SequenceMatcher(None, [norm(x) for x in xa], [norm(y) for y in yb], autojunk=False)
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag != "equal":
            continue
        for k in range(i2 - i1):
            x, y = xa[i1 + k], yb[j1 + k]
            if x == y:
                continue
            if x.strip() == y.strip():
                result = max(result, 1)
            else:
                return 2
    return result


def build_payload(an: Analysis, title: str) -> dict:
    files = an.files
    move_a = [[-1] * len(f.a) for f in files]
    move_b = [[-1] * len(f.b) for f in files]
    for mid, m in enumerate(an.moves):
        for k in range(m.na):
            move_a[m.sf][m.si + k] = mid
        for k in range(m.nb):
            move_b[m.df][m.dj + k] = mid
    out_files = []
    for fi, f in enumerate(files):
        ca = ["e"] * len(f.a)
        cb = ["e"] * len(f.b)
        sa: dict[int, list] = {}
        sb: dict[int, list] = {}
        ops = []
        for tag, i1, i2, j1, j2 in f.opcodes:
            t = {"equal": "e", "delete": "d", "insert": "a", "replace": "c"}[tag]
            ops.append([t, i1, i2, j1, j2])
            for i in range(i1, i2):
                ca[i] = "e" if t == "e" else ("d" if t == "d" else "c")
            for j in range(j1, j2):
                cb[j] = "e" if t == "e" else ("a" if t == "a" else "c")
            if tag == "replace":
                # Pair the changed lines in order to highlight changes inside lines.
                olds = [i for i in range(i1, i2) if move_a[fi][i] < 0]
                news = [j for j in range(j1, j2) if move_b[fi][j] < 0]
                ptr = 0
                for i in olds:
                    best, best_j = SIM_LINE, -1
                    for jj in range(ptr, min(ptr + 8, len(news))):
                        r = difflib.SequenceMatcher(None, f.a[i], f.b[news[jj]], autojunk=False).ratio()
                        if r > best:
                            best, best_j = r, jj
                    if best_j >= 0:
                        x, y = change_spans(f.a[i], f.b[news[best_j]])
                        sa[i], sb[news[best_j]] = x, y
                        ptr = best_j + 1
        for i, mid in enumerate(move_a[fi]):
            if mid >= 0:
                ca[i] = KIND_CLASS[an.moves[mid].kind]
        for j, mid in enumerate(move_b[fi]):
            if mid >= 0:
                cb[j] = KIND_CLASS[an.moves[mid].kind]
        out_files.append(
            {
                "status": f.status,
                "old": f.old_path,
                "new": f.new_path,
                "binary": f.binary,
                "a": f.a,
                "b": f.b,
                "ca": "".join(ca),
                "cb": "".join(cb),
                "sa": sa,
                "sb": sb,
                "ha": syntax_for(f.old_path, f.a),
                "hb": syntax_for(f.new_path, f.b),
                "ops": ops,
                "ma": [],
                "mb": [],
            }
        )
    for of in out_files:
        of["ca"], of["cb"] = list(of["ca"]), list(of["cb"])
    changed_counts = []
    ws_changes = []
    for mid, m in enumerate(an.moves):
        changed = 0
        ws_changes.append(
            whitespace_change(files[m.sf].a[m.si : m.si + m.na], files[m.df].b[m.dj : m.dj + m.nb])
        )
        if m.kind == "similar":
            # Align the two sides of the block and highlight the edits inside it.
            # Only the changed lines keep the "s" class. The other lines are plain moved lines.
            xa = files[m.sf].a[m.si : m.si + m.na]
